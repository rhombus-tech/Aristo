# NASDAQ Cloud Data Service credentials template
# Copy this file to nasdaq_credentials.env and fill in your actual credentials
# IMPORTANT: Never commit your actual credentials to version control

# OAuth2 Authentication
NASDAQ_CLIENT_ID=your-client-id
NASDAQ_CLIENT_SECRET=your-client-secret
NASDAQ_TOKEN_ENDPOINT=https://clouddataservice.auth.nasdaq.com/auth/realms/pro-realm/protocol/openid-connect/token
NASDAQ_BOOTSTRAP_SERVER=kafka-bootstrap.clouddataservice.nasdaq.com:9094

# TEE Integration Settings
TEE_ENDPOINT=http://localhost:8080/api/v1/nasdaq-data
TEE_REGION=us-east

# Topic Configuration
# These are the topics you're entitled to:
# - QBBO-A-CORE (Nasdaq Basic - Tape A)
# - QBBO-B-CORE (Nasdaq Basic - Tape B)
# - QBBO-C-CORE (Nasdaq Basic - Tape C)
# - NLSCTA (NLS Plus - CTA)
# - NLSUTP (NLS Plus - UTP)
