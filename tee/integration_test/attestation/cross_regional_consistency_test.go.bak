		assert.False(t, apResult, "External execution should fail in AP region despite accumulator propagation")
		assert.Error(t, apErr, "Error expected for external execution in AP region")
		assert.Contains(t, apErr.Error(), "external execution", "Error should indicate external execution restriction")

		// Create a standard attestation without external execution
		standardAttestation := createTestSGXAttestation()
		standardAttestation.EnclaveID = baseEnclaveID
		standardAttestation.Measurement = baseMeasurement
		standardAttestation.RegionID = RegionAPSouth
		standardAttestation.Data = []byte("standard_execution=true;transaction=123")

		// Verify in AP region without external execution - should pass
		apResult, apErr = apVerifier.Verify(standardAttestation)
		assert.True(t, apResult, "Standard execution should pass in AP region")
		assert.NoError(t, apErr, "No error expected for standard execution in AP region")
	})

	// TEST CASE 3: Cross-Regional Policy Consistency
	t.Run("CrossRegionalPolicyConsistency", func(t *testing.T) {
		// Create a multi-region TEE that needs to be valid in all regions
		multiRegionEnclaveID := make([]byte, 32)
