		universalAttestation.EnclaveID = multiRegionEnclaveID
		universalAttestation.Measurement = multiRegionMeasurement
		universalAttestation.CrossSignature = make([]byte, 64)
		rand.Read(universalAttestation.CrossSignature)
		universalAttestation.Data = []byte("standard_execution=true;transaction=999")

		// Check in all regions
		for regionID, verifier := range map[string]*AttestationVerifier{
			RegionUSEast:    usVerifier,
			RegionEUCentral: euVerifier,
			RegionAPSouth:   apVerifier,
		} {
			universalAttestation.RegionID = regionID
			result, err := verifier.Verify(universalAttestation)
			assert.True(t, result, "Universal attestation should pass in %s region", regionID)
			assert.NoError(t, err, "No error expected for universal attestation in %s region", regionID)
		}

		// Simulate a latency-induced accumulator update issue
		// When one region updates its policies but propagation hasn't completed
		// Set a new stricter policy in EU region
		euRegistry.SetRegionalPolicy(RegionEUCentral, "strict_measurements", true)

		// Create a test to verify that attestation with AP and US registrations, 
		// but using EU's new policy, should still pass in AP and US but fail in EU
		newEnclaveID := make([]byte, 32)
		newMeasurement := make([]byte, 32)
		rand.Read(newEnclaveID)
		rand.Read(newMeasurement)

		// Only register in US and AP
		usRegistry.RegisterTEE(newEnclaveID, newMeasurement)
		usRegistry.RegisterTEEInAccumulator(newEnclaveID, newMeasurement)
		// Propagate only to AP, not to EU
		network.PropagateAccumulator(RegionUSEast, RegionAPSouth, newEnclaveID, newMeasurement, 5)

		// Create a policy-compliant attestation
		policyAttestation := createTestDualAttestation()
		policyAttestation.EnclaveID = newEnclaveID
		policyAttestation.Measurement = newMeasurement
		policyAttestation.CrossSignature = make([]byte, 64)
		rand.Read(policyAttestation.CrossSignature)
		policyAttestation.Data = []byte("standard_execution=true;transaction=555")

		// Test in US - should pass
		policyAttestation.RegionID = RegionUSEast
		usResult, usErr := usVerifier.Verify(policyAttestation)
		assert.True(t, usResult, "Policy attestation should pass in US region")
		assert.NoError(t, usErr, "No error expected in US region")

		// Test in AP - should pass
		policyAttestation.RegionID = RegionAPSouth
		apResult, apErr := apVerifier.Verify(policyAttestation)
		assert.True(t, apResult, "Policy attestation should pass in AP region")
		assert.NoError(t, apErr, "No error expected in AP region")

		// Test in EU - should fail as not registered in EU and EU has stricter policy
		policyAttestation.RegionID = RegionEUCentral
		euResult, euErr := euVerifier.Verify(policyAttestation)
		assert.False(t, euResult, "Policy attestation should fail in EU region")
		assert.Error(t, euErr, "Error expected in EU region due to missing registration")
	})
}
// TestCrossRegionalAccumulatorConsistency tests accumulator consistency across regions
func TestCrossRegionalAccumulatorConsistency(t *testing.T) {
	// Create a multi-region network with three regions
	network := NewMultiRegionNetwork(RegionUSEast, RegionEUCentral, RegionAPSouth)
	network.ConfigureCrossRegionalVerification()
	
	// Configure regional policies
	enforcer := NewRegionalPolicyEnforcer(network)
	enforcer.ConfigureAccumulatorThresholds()
	
	// Create a test TEE and register in US-East
	enclaveID := make([]byte, 32)
	measurement := make([]byte, 32)
	rand.Read(enclaveID)
	rand.Read(measurement)
	
	usRegistry := network.GetRegistry(RegionUSEast)
	usRegistry.RegisterTEE(enclaveID, measurement)
	usRegistry.RegisterTEEInAccumulator(enclaveID, measurement)
	
	// Verify initial state - US-East has the TEE, others don't
	accValue, exists := usRegistry.accumulatorTEEs[string(enclaveID)]
	assert.True(t, exists, "US-East should have the TEE registered in accumulator")
	
	euRegistry := network.GetRegistry(RegionEUCentral)
	_, exists = euRegistry.accumulatorTEEs[string(enclaveID)]
	assert.False(t, exists, "EU-Central should not have the TEE yet")
	
	// Propagate accumulator to other regions with different latencies
	euPropagationTime := network.PropagateAccumulator(RegionUSEast, RegionEUCentral, enclaveID, measurement, 50)
	apPropagationTime := network.PropagateAccumulator(RegionUSEast, RegionAPSouth, enclaveID, measurement, 85)
	
	// Verify propagation times are within regional policy limits
	maxConvergenceTime := usRegistry.regionalPolicies[RegionUSEast][PolicyMaxConvergenceTime].(int)
	assert.LessOrEqual(t, euPropagationTime, maxConvergenceTime, "EU propagation time exceeds policy limit")
	assert.LessOrEqual(t, apPropagationTime, maxConvergenceTime, "AP propagation time exceeds policy limit")
	
	// Verify accumulators are consistent across regions
	euAccValue, exists := euRegistry.accumulatorTEEs[string(enclaveID)]
	assert.True(t, exists, "EU-Central should now have the TEE")
	assert.True(t, bytes.Equal(accValue, euAccValue), "Accumulators should be identical")
	
	apRegistry := network.GetRegistry(RegionAPSouth)
	apAccValue, exists := apRegistry.accumulatorTEEs[string(enclaveID)]
	assert.True(t, exists, "AP-South should now have the TEE")
	assert.True(t, bytes.Equal(accValue, apAccValue), "Accumulators should be identical")
}

// TestCrossRegionalPolicyPropagation tests that regional policies are correctly enforced
// during TEE attestation propagation across regions with different policy requirements
func TestCrossRegionalPolicyPropagation(t *testing.T) {
	// Create a multi-region network with three regions having different policy requirements
	network := NewMultiRegionNetwork(RegionUSEast, RegionEUCentral, RegionAPSouth)
	network.ConfigureCrossRegionalVerification()

	// Get registries for each region
	usRegistry := network.GetRegistry(RegionUSEast)
	euRegistry := network.GetRegistry(RegionEUCentral)
	apRegistry := network.GetRegistry(RegionAPSouth)

	// Create verifiers for each region
	usVerifier := NewAttestationVerifier(usRegistry)
	euVerifier := NewAttestationVerifier(euRegistry)
	apVerifier := NewAttestationVerifier(apRegistry)

	// Configure regional policies with different requirements
	// 1. EU requires dual attestation
	euRegistry.SetRegionalPolicy(RegionEUCentral, PolicyRequireDualAttestation, true)
	// 2. AP disallows external execution
	apRegistry.SetRegionalPolicy(RegionAPSouth, PolicyAllowExternalExecution, false)
	// 3. US allows both single attestation and external execution
	usRegistry.SetRegionalPolicy(RegionUSEast, PolicyRequireDualAttestation, false)
	usRegistry.SetRegionalPolicy(RegionUSEast, PolicyAllowExternalExecution, true)

	// Register a test TEE in the US region
	baseEnclaveID := make([]byte, 32)
	baseMeasurement := make([]byte, 32)
	rand.Read(baseEnclaveID)
	rand.Read(baseMeasurement)

	usRegistry.RegisterTEE(baseEnclaveID, baseMeasurement)
	usRegistry.RegisterTEEInAccumulator(baseEnclaveID, baseMeasurement)

	// TEST CASE 1: TEE Propagation with Single Attestation
	t.Run("SingleAttestationPropagation", func(t *testing.T) {
		// Create a single attestation for the US region
		singleAttestation := createTestSGXAttestation()
		singleAttestation.EnclaveID = baseEnclaveID
		singleAttestation.Measurement = baseMeasurement
		singleAttestation.RegionID = RegionUSEast

		// Verify in US region - should pass
		usResult, usErr := usVerifier.Verify(singleAttestation)
		assert.True(t, usResult, "Single attestation should pass in US region")
		assert.NoError(t, usErr, "No error expected for single attestation in US region")

		// Propagate the TEE to EU region
		network.PropagateAccumulator(RegionUSEast, RegionEUCentral, baseEnclaveID, baseMeasurement, 10)

		// The accumulator is now updated in EU region, but the single attestation should still fail
		// due to EU region's dual attestation policy
		singleAttestation.RegionID = RegionEUCentral
		euResult, euErr := euVerifier.Verify(singleAttestation)
		assert.False(t, euResult, "Single attestation should fail in EU region despite accumulator propagation")
		assert.Error(t, euErr, "Error expected for single attestation in EU region")
		assert.Contains(t, euErr.Error(), "dual attestation", "Error should indicate dual attestation requirement")

		// Create a dual attestation that should pass in EU
		dualAttestation := createTestDualAttestation()
		dualAttestation.EnclaveID = baseEnclaveID
		dualAttestation.Measurement = baseMeasurement
		dualAttestation.RegionID = RegionEUCentral
		dualAttestation.CrossSignature = make([]byte, 64) // Add cross-signature
		rand.Read(dualAttestation.CrossSignature)

		// Verify in EU region with dual attestation - should pass
		euResult, euErr = euVerifier.Verify(dualAttestation)
		assert.True(t, euResult, "Dual attestation should pass in EU region")
		assert.NoError(t, euErr, "No error expected for dual attestation in EU region")
	})

	// TEST CASE 2: External Execution Propagation
	t.Run("ExternalExecutionPropagation", func(t *testing.T) {
		// Create an external execution attestation for the US region
		externalAttestation := createTestSGXAttestation()
		externalAttestation.EnclaveID = baseEnclaveID
		externalAttestation.Measurement = baseMeasurement
		externalAttestation.RegionID = RegionUSEast
		externalAttestation.Data = []byte("external_execution=true;transaction=123")

		// Verify in US region - should pass as US allows external execution
		usResult, usErr := usVerifier.Verify(externalAttestation)
		assert.True(t, usResult, "External execution should pass in US region")
		assert.NoError(t, usErr, "No error expected for external execution in US region")

		// Propagate the TEE to AP region
		network.PropagateAccumulator(RegionUSEast, RegionAPSouth, baseEnclaveID, baseMeasurement, 15)

		// The accumulator is now updated in AP region, but the external execution attestation should fail
		// due to AP region's policy against external execution
		externalAttestation.RegionID = RegionAPSouth
		apResult, apErr := apVerifier.Verify(externalAttestation)
		assert.False(t, apResult, "External execution should fail in AP region despite accumulator propagation")
		assert.Error(t, apErr, "Error expected for external execution in AP region")
		assert.Contains(t, apErr.Error(), "external execution", "Error should indicate external execution restriction")

		// Create a standard attestation without external execution
		standardAttestation := createTestSGXAttestation()
		standardAttestation.EnclaveID = baseEnclaveID
		standardAttestation.Measurement = baseMeasurement
		standardAttestation.RegionID = RegionAPSouth
		standardAttestation.Data = []byte("standard_execution=true;transaction=123")

		// Verify in AP region without external execution - should pass
		apResult, apErr = apVerifier.Verify(standardAttestation)
		assert.True(t, apResult, "Standard execution should pass in AP region")
		assert.NoError(t, apErr, "No error expected for standard execution in AP region")
	})

	// TEST CASE 3: Cross-Regional Policy Consistency
	t.Run("CrossRegionalPolicyConsistency", func(t *testing.T) {
		// Create a multi-region TEE that needs to be valid in all regions
		multiRegionEnclaveID := make([]byte, 32)
		multiRegionMeasurement := make([]byte, 32)
		rand.Read(multiRegionEnclaveID)
		rand.Read(multiRegionMeasurement)

		// Register in all regions
		for _, registry := range []*MockTEERegistry{usRegistry, euRegistry, apRegistry} {
			registry.RegisterTEE(multiRegionEnclaveID, multiRegionMeasurement)
			registry.RegisterTEEInAccumulator(multiRegionEnclaveID, multiRegionMeasurement)
		}

		// Create an attestation that should be valid in all regions
		// It must be dual attestation (for EU) and avoid external execution (for AP)
		universalAttestation := createTestDualAttestation()
		universalAttestation.EnclaveID = multiRegionEnclaveID
		universalAttestation.Measurement = multiRegionMeasurement
		universalAttestation.CrossSignature = make([]byte, 64)
		rand.Read(universalAttestation.CrossSignature)
		universalAttestation.Data = []byte("standard_execution=true;transaction=999")

		// Check in all regions
		for regionID, verifier := range map[string]*AttestationVerifier{
			RegionUSEast:    usVerifier,
			RegionEUCentral: euVerifier,
			RegionAPSouth:   apVerifier,
		} {
			universalAttestation.RegionID = regionID
			result, err := verifier.Verify(universalAttestation)
			assert.True(t, result, "Universal attestation should pass in %s region", regionID)
			assert.NoError(t, err, "No error expected for universal attestation in %s region", regionID)
		}

		// Simulate a latency-induced accumulator update issue
		// When one region updates its policies but propagation hasn't completed
		// Set a new stricter policy in EU region
		euRegistry.SetRegionalPolicy(RegionEUCentral, "strict_measurements", true)

		// Create a test to verify that attestation with AP and US registrations, 
		// but using EU's new policy, should still pass in AP and US but fail in EU
		newEnclaveID := make([]byte, 32)
		newMeasurement := make([]byte, 32)
		rand.Read(newEnclaveID)
		rand.Read(newMeasurement)

		// Only register in US and AP
		usRegistry.RegisterTEE(newEnclaveID, newMeasurement)
		usRegistry.RegisterTEEInAccumulator(newEnclaveID, newMeasurement)
		// Propagate only to AP, not to EU
		network.PropagateAccumulator(RegionUSEast, RegionAPSouth, newEnclaveID, newMeasurement, 5)

		// Create a policy-compliant attestation
		policyAttestation := createTestDualAttestation()
		policyAttestation.EnclaveID = newEnclaveID
		policyAttestation.Measurement = newMeasurement
		policyAttestation.CrossSignature = make([]byte, 64)
		rand.Read(policyAttestation.CrossSignature)
		policyAttestation.Data = []byte("standard_execution=true;transaction=555")

		// Test in US - should pass
		policyAttestation.RegionID = RegionUSEast
		usResult, usErr := usVerifier.Verify(policyAttestation)
		assert.True(t, usResult, "Policy attestation should pass in US region")
		assert.NoError(t, usErr, "No error expected in US region")

		// Test in AP - should pass
		policyAttestation.RegionID = RegionAPSouth
		apResult, apErr := apVerifier.Verify(policyAttestation)
		assert.True(t, apResult, "Policy attestation should pass in AP region")
		assert.NoError(t, apErr, "No error expected in AP region")

		// Test in EU - should fail as not registered in EU and EU has stricter policy
		policyAttestation.RegionID = RegionEUCentral
		euResult, euErr := euVerifier.Verify(policyAttestation)
		assert.False(t, euResult, "Policy attestation should fail in EU region")
		assert.Error(t, euErr, "Error expected in EU region due to missing registration")
	})
}
// TestAccumulatorThresholdVerification tests the system's ability to handle small deviations in accumulators
func TestAccumulatorThresholdVerification(t *testing.T) {
	// Create a multi-region network
	network := NewMultiRegionNetwork(RegionUSEast, RegionEUCentral)
	network.ConfigureCrossRegionalVerification()
	
	// Configure regional policies
	enforcer := NewRegionalPolicyEnforcer(network)
	enforcer.ConfigureAccumulatorThresholds()
	
	// Create a test TEE and register in US-East
	enclaveID := make([]byte, 32)
	measurement := make([]byte, 32)
	rand.Read(enclaveID)
	rand.Read(measurement)
	
	usRegistry := network.GetRegistry(RegionUSEast)
	euRegistry := network.GetRegistry(RegionEUCentral)
	
	usRegistry.RegisterTEE(enclaveID, measurement)
	usRegistry.RegisterTEEInAccumulator(enclaveID, measurement)

	// Get the original accumulator value
	originalAccValue := usRegistry.accumulatorTEEs[string(enclaveID)]

	// Create a slightly modified accumulator value (1 byte different)
	modifiedAccValue := make([]byte, len(originalAccValue))
	copy(modifiedAccValue, originalAccValue)
	modifiedAccValue[len(modifiedAccValue)-1] ^= 1 // Flip one bit in the last byte

	// Simulate propagation with a slight modification
	euRegistry.RegisterTEE(enclaveID, measurement)
	euRegistry.accumulatorTEEs[string(enclaveID)] = modifiedAccValue

	// Get max allowed divergence
	maxDivergence := usRegistry.regionalPolicies[RegionUSEast][PolicyMaxAccumulatorDivergence].(int)

	// Create a verifier for each region
	usVerifier := NewAttestationVerifier(usRegistry)
	euVerifier := NewAttestationVerifier(euRegistry)

	// Create test attestations for each region
	usAttestation := createTestAttestationWithAccumulator()
	usAttestation.EnclaveID = enclaveID
	usAttestation.Measurement = measurement
	usAttestation.RegionID = RegionUSEast

	euAttestation := createTestAttestationWithAccumulator()
	euAttestation.EnclaveID = enclaveID
	euAttestation.Measurement = measurement
	euAttestation.RegionID = RegionEUCentral

	// Calculate byte difference (should be 1)
	diffCount := 0
	for i := 0; i < len(originalAccValue); i++ {
		if originalAccValue[i] != modifiedAccValue[i] {
			diffCount++
		}

// TestCrossRegionalPolicyPropagation tests that regional policies are correctly enforced
// during TEE attestation propagation across regions with different policy requirements
func TestCrossRegionalPolicyPropagation(t *testing.T) {
	// Create a multi-region network with three regions having different policy requirements
	network := NewMultiRegionNetwork(RegionUSEast, RegionEUCentral, RegionAPSouth)
	network.ConfigureCrossRegionalVerification()

	// Get registries for each region
	usRegistry := network.GetRegistry(RegionUSEast)
	euRegistry := network.GetRegistry(RegionEUCentral)
	apRegistry := network.GetRegistry(RegionAPSouth)

	// Create verifiers for each region
	usVerifier := NewAttestationVerifier(usRegistry)
	euVerifier := NewAttestationVerifier(euRegistry)
	apVerifier := NewAttestationVerifier(apRegistry)

	// Configure regional policies with different requirements
	// 1. EU requires dual attestation
	euRegistry.SetRegionalPolicy(RegionEUCentral, PolicyRequireDualAttestation, true)
	// 2. AP disallows external execution
	apRegistry.SetRegionalPolicy(RegionAPSouth, PolicyAllowExternalExecution, false)
	// 3. US allows both single attestation and external execution
	usRegistry.SetRegionalPolicy(RegionUSEast, PolicyRequireDualAttestation, false)
	usRegistry.SetRegionalPolicy(RegionUSEast, PolicyAllowExternalExecution, true)

	// Register a test TEE in the US region
	baseEnclaveID := make([]byte, 32)
	baseMeasurement := make([]byte, 32)
	rand.Read(baseEnclaveID)
	rand.Read(baseMeasurement)

	usRegistry.RegisterTEE(baseEnclaveID, baseMeasurement)
	usRegistry.RegisterTEEInAccumulator(baseEnclaveID, baseMeasurement)

	// TEST CASE 1: TEE Propagation with Single Attestation
	t.Run("SingleAttestationPropagation", func(t *testing.T) {
		// Create a single attestation for the US region
		singleAttestation := createTestSGXAttestation()
		singleAttestation.EnclaveID = baseEnclaveID
		singleAttestation.Measurement = baseMeasurement
		singleAttestation.RegionID = RegionUSEast

		// Verify in US region - should pass
		usResult, usErr := usVerifier.Verify(singleAttestation)
		assert.True(t, usResult, "Single attestation should pass in US region")
		assert.NoError(t, usErr, "No error expected for single attestation in US region")

		// Propagate the TEE to EU region
		network.PropagateAccumulator(RegionUSEast, RegionEUCentral, baseEnclaveID, baseMeasurement, 10)

		// The accumulator is now updated in EU region, but the single attestation should still fail
		// due to EU region's dual attestation policy
		singleAttestation.RegionID = RegionEUCentral
		euResult, euErr := euVerifier.Verify(singleAttestation)
		assert.False(t, euResult, "Single attestation should fail in EU region despite accumulator propagation")
		assert.Error(t, euErr, "Error expected for single attestation in EU region")
		assert.Contains(t, euErr.Error(), "dual attestation", "Error should indicate dual attestation requirement")

		// Create a dual attestation that should pass in EU
		dualAttestation := createTestDualAttestation()
		dualAttestation.EnclaveID = baseEnclaveID
		dualAttestation.Measurement = baseMeasurement
		dualAttestation.RegionID = RegionEUCentral
		dualAttestation.CrossSignature = make([]byte, 64) // Add cross-signature
		rand.Read(dualAttestation.CrossSignature)

		// Verify in EU region with dual attestation - should pass
		euResult, euErr = euVerifier.Verify(dualAttestation)
		assert.True(t, euResult, "Dual attestation should pass in EU region")
		assert.NoError(t, euErr, "No error expected for dual attestation in EU region")
	})

	// TEST CASE 2: External Execution Propagation
	t.Run("ExternalExecutionPropagation", func(t *testing.T) {
		// Create an external execution attestation for the US region
		externalAttestation := createTestSGXAttestation()
		externalAttestation.EnclaveID = baseEnclaveID
		externalAttestation.Measurement = baseMeasurement
		externalAttestation.RegionID = RegionUSEast
		externalAttestation.Data = []byte("external_execution=true;transaction=123")

		// Verify in US region - should pass as US allows external execution
		usResult, usErr := usVerifier.Verify(externalAttestation)
		assert.True(t, usResult, "External execution should pass in US region")
		assert.NoError(t, usErr, "No error expected for external execution in US region")

		// Propagate the TEE to AP region
		network.PropagateAccumulator(RegionUSEast, RegionAPSouth, baseEnclaveID, baseMeasurement, 15)

		// The accumulator is now updated in AP region, but the external execution attestation should fail
		// due to AP region's policy against external execution
		externalAttestation.RegionID = RegionAPSouth
		apResult, apErr := apVerifier.Verify(externalAttestation)
		assert.False(t, apResult, "External execution should fail in AP region despite accumulator propagation")
		assert.Error(t, apErr, "Error expected for external execution in AP region")
		assert.Contains(t, apErr.Error(), "external execution", "Error should indicate external execution restriction")

		// Create a standard attestation without external execution
		standardAttestation := createTestSGXAttestation()
		standardAttestation.EnclaveID = baseEnclaveID
		standardAttestation.Measurement = baseMeasurement
		standardAttestation.RegionID = RegionAPSouth
		standardAttestation.Data = []byte("standard_execution=true;transaction=123")

		// Verify in AP region without external execution - should pass
		apResult, apErr = apVerifier.Verify(standardAttestation)
		assert.True(t, apResult, "Standard execution should pass in AP region")
		assert.NoError(t, apErr, "No error expected for standard execution in AP region")
	})

	// TEST CASE 3: Cross-Regional Policy Consistency
	t.Run("CrossRegionalPolicyConsistency", func(t *testing.T) {
		// Create a multi-region TEE that needs to be valid in all regions
		multiRegionEnclaveID := make([]byte, 32)
		multiRegionMeasurement := make([]byte, 32)
		rand.Read(multiRegionEnclaveID)
		rand.Read(multiRegionMeasurement)

		// Register in all regions
		for _, registry := range []*MockTEERegistry{usRegistry, euRegistry, apRegistry} {
			registry.RegisterTEE(multiRegionEnclaveID, multiRegionMeasurement)
			registry.RegisterTEEInAccumulator(multiRegionEnclaveID, multiRegionMeasurement)
		}

		// Create an attestation that should be valid in all regions
		// It must be dual attestation (for EU) and avoid external execution (for AP)
		universalAttestation := createTestDualAttestation()
		universalAttestation.EnclaveID = multiRegionEnclaveID
		universalAttestation.Measurement = multiRegionMeasurement
		universalAttestation.CrossSignature = make([]byte, 64)
		rand.Read(universalAttestation.CrossSignature)
		universalAttestation.Data = []byte("standard_execution=true;transaction=999")

		// Check in all regions
		for regionID, verifier := range map[string]*AttestationVerifier{
			RegionUSEast:    usVerifier,
			RegionEUCentral: euVerifier,
			RegionAPSouth:   apVerifier,
		} {
			universalAttestation.RegionID = regionID
			result, err := verifier.Verify(universalAttestation)
			assert.True(t, result, "Universal attestation should pass in %s region", regionID)
			assert.NoError(t, err, "No error expected for universal attestation in %s region", regionID)
		}

		// Simulate a latency-induced accumulator update issue
		// When one region updates its policies but propagation hasn't completed
		// Set a new stricter policy in EU region
		euRegistry.SetRegionalPolicy(RegionEUCentral, "strict_measurements", true)

		// Create a test to verify that attestation with AP and US registrations, 
		// but using EU's new policy, should still pass in AP and US but fail in EU
		newEnclaveID := make([]byte, 32)
		newMeasurement := make([]byte, 32)
		rand.Read(newEnclaveID)
		rand.Read(newMeasurement)

		// Only register in US and AP
		usRegistry.RegisterTEE(newEnclaveID, newMeasurement)
		usRegistry.RegisterTEEInAccumulator(newEnclaveID, newMeasurement)
		// Propagate only to AP, not to EU
		network.PropagateAccumulator(RegionUSEast, RegionAPSouth, newEnclaveID, newMeasurement, 5)

		// Create a policy-compliant attestation
		policyAttestation := createTestDualAttestation()
		policyAttestation.EnclaveID = newEnclaveID
		policyAttestation.Measurement = newMeasurement
		policyAttestation.CrossSignature = make([]byte, 64)
		rand.Read(policyAttestation.CrossSignature)
		policyAttestation.Data = []byte("standard_execution=true;transaction=555")

		// Test in US - should pass
		policyAttestation.RegionID = RegionUSEast
		usResult, usErr := usVerifier.Verify(policyAttestation)
		assert.True(t, usResult, "Policy attestation should pass in US region")
		assert.NoError(t, usErr, "No error expected in US region")

		// Test in AP - should pass
		policyAttestation.RegionID = RegionAPSouth
		apResult, apErr := apVerifier.Verify(policyAttestation)
		assert.True(t, apResult, "Policy attestation should pass in AP region")
		assert.NoError(t, apErr, "No error expected in AP region")

		// Test in EU - should fail as not registered in EU and EU has stricter policy
		policyAttestation.RegionID = RegionEUCentral
		euResult, euErr := euVerifier.Verify(policyAttestation)
		assert.False(t, euResult, "Policy attestation should fail in EU region")
		assert.Error(t, euErr, "Error expected in EU region due to missing registration")
	})
}	}

// TestCrossRegionalPolicyPropagation tests that regional policies are correctly enforced
// during TEE attestation propagation across regions with different policy requirements
func TestCrossRegionalPolicyPropagation(t *testing.T) {
	// Create a multi-region network with three regions having different policy requirements
	network := NewMultiRegionNetwork(RegionUSEast, RegionEUCentral, RegionAPSouth)
	network.ConfigureCrossRegionalVerification()

	// Get registries for each region
	usRegistry := network.GetRegistry(RegionUSEast)
	euRegistry := network.GetRegistry(RegionEUCentral)
	apRegistry := network.GetRegistry(RegionAPSouth)

	// Create verifiers for each region
	usVerifier := NewAttestationVerifier(usRegistry)
	euVerifier := NewAttestationVerifier(euRegistry)
	apVerifier := NewAttestationVerifier(apRegistry)

	// Configure regional policies with different requirements
	// 1. EU requires dual attestation
	euRegistry.SetRegionalPolicy(RegionEUCentral, PolicyRequireDualAttestation, true)
	// 2. AP disallows external execution
	apRegistry.SetRegionalPolicy(RegionAPSouth, PolicyAllowExternalExecution, false)
	// 3. US allows both single attestation and external execution
	usRegistry.SetRegionalPolicy(RegionUSEast, PolicyRequireDualAttestation, false)
	usRegistry.SetRegionalPolicy(RegionUSEast, PolicyAllowExternalExecution, true)

	// Register a test TEE in the US region
	baseEnclaveID := make([]byte, 32)
	baseMeasurement := make([]byte, 32)
	rand.Read(baseEnclaveID)
	rand.Read(baseMeasurement)

	usRegistry.RegisterTEE(baseEnclaveID, baseMeasurement)
	usRegistry.RegisterTEEInAccumulator(baseEnclaveID, baseMeasurement)

	// TEST CASE 1: TEE Propagation with Single Attestation
	t.Run("SingleAttestationPropagation", func(t *testing.T) {
		// Create a single attestation for the US region
		singleAttestation := createTestSGXAttestation()
		singleAttestation.EnclaveID = baseEnclaveID
		singleAttestation.Measurement = baseMeasurement
		singleAttestation.RegionID = RegionUSEast

		// Verify in US region - should pass
		usResult, usErr := usVerifier.Verify(singleAttestation)
		assert.True(t, usResult, "Single attestation should pass in US region")
		assert.NoError(t, usErr, "No error expected for single attestation in US region")

		// Propagate the TEE to EU region
		network.PropagateAccumulator(RegionUSEast, RegionEUCentral, baseEnclaveID, baseMeasurement, 10)

		// The accumulator is now updated in EU region, but the single attestation should still fail
		// due to EU region's dual attestation policy
		singleAttestation.RegionID = RegionEUCentral
		euResult, euErr := euVerifier.Verify(singleAttestation)
		assert.False(t, euResult, "Single attestation should fail in EU region despite accumulator propagation")
		assert.Error(t, euErr, "Error expected for single attestation in EU region")
		assert.Contains(t, euErr.Error(), "dual attestation", "Error should indicate dual attestation requirement")

		// Create a dual attestation that should pass in EU
		dualAttestation := createTestDualAttestation()
		dualAttestation.EnclaveID = baseEnclaveID
		dualAttestation.Measurement = baseMeasurement
		dualAttestation.RegionID = RegionEUCentral
		dualAttestation.CrossSignature = make([]byte, 64) // Add cross-signature
		rand.Read(dualAttestation.CrossSignature)

		// Verify in EU region with dual attestation - should pass
		euResult, euErr = euVerifier.Verify(dualAttestation)
		assert.True(t, euResult, "Dual attestation should pass in EU region")
		assert.NoError(t, euErr, "No error expected for dual attestation in EU region")
	})

	// TEST CASE 2: External Execution Propagation
	t.Run("ExternalExecutionPropagation", func(t *testing.T) {
		// Create an external execution attestation for the US region
		externalAttestation := createTestSGXAttestation()
		externalAttestation.EnclaveID = baseEnclaveID
		externalAttestation.Measurement = baseMeasurement
		externalAttestation.RegionID = RegionUSEast
		externalAttestation.Data = []byte("external_execution=true;transaction=123")

		// Verify in US region - should pass as US allows external execution
		usResult, usErr := usVerifier.Verify(externalAttestation)
		assert.True(t, usResult, "External execution should pass in US region")
		assert.NoError(t, usErr, "No error expected for external execution in US region")

		// Propagate the TEE to AP region
		network.PropagateAccumulator(RegionUSEast, RegionAPSouth, baseEnclaveID, baseMeasurement, 15)

		// The accumulator is now updated in AP region, but the external execution attestation should fail
		// due to AP region's policy against external execution
		externalAttestation.RegionID = RegionAPSouth
		apResult, apErr := apVerifier.Verify(externalAttestation)
		assert.False(t, apResult, "External execution should fail in AP region despite accumulator propagation")
		assert.Error(t, apErr, "Error expected for external execution in AP region")
		assert.Contains(t, apErr.Error(), "external execution", "Error should indicate external execution restriction")

		// Create a standard attestation without external execution
		standardAttestation := createTestSGXAttestation()
		standardAttestation.EnclaveID = baseEnclaveID
		standardAttestation.Measurement = baseMeasurement
		standardAttestation.RegionID = RegionAPSouth
		standardAttestation.Data = []byte("standard_execution=true;transaction=123")

		// Verify in AP region without external execution - should pass
		apResult, apErr = apVerifier.Verify(standardAttestation)
		assert.True(t, apResult, "Standard execution should pass in AP region")
		assert.NoError(t, apErr, "No error expected for standard execution in AP region")
	})

	// TEST CASE 3: Cross-Regional Policy Consistency
	t.Run("CrossRegionalPolicyConsistency", func(t *testing.T) {
		// Create a multi-region TEE that needs to be valid in all regions
		multiRegionEnclaveID := make([]byte, 32)
		multiRegionMeasurement := make([]byte, 32)
		rand.Read(multiRegionEnclaveID)
		rand.Read(multiRegionMeasurement)

		// Register in all regions
		for _, registry := range []*MockTEERegistry{usRegistry, euRegistry, apRegistry} {
			registry.RegisterTEE(multiRegionEnclaveID, multiRegionMeasurement)
			registry.RegisterTEEInAccumulator(multiRegionEnclaveID, multiRegionMeasurement)
		}

		// Create an attestation that should be valid in all regions
		// It must be dual attestation (for EU) and avoid external execution (for AP)
		universalAttestation := createTestDualAttestation()
		universalAttestation.EnclaveID = multiRegionEnclaveID
		universalAttestation.Measurement = multiRegionMeasurement
		universalAttestation.CrossSignature = make([]byte, 64)
		rand.Read(universalAttestation.CrossSignature)
		universalAttestation.Data = []byte("standard_execution=true;transaction=999")

		// Check in all regions
		for regionID, verifier := range map[string]*AttestationVerifier{
			RegionUSEast:    usVerifier,
			RegionEUCentral: euVerifier,
			RegionAPSouth:   apVerifier,
		} {
			universalAttestation.RegionID = regionID
			result, err := verifier.Verify(universalAttestation)
			assert.True(t, result, "Universal attestation should pass in %s region", regionID)
			assert.NoError(t, err, "No error expected for universal attestation in %s region", regionID)
		}

		// Simulate a latency-induced accumulator update issue
		// When one region updates its policies but propagation hasn't completed
		// Set a new stricter policy in EU region
		euRegistry.SetRegionalPolicy(RegionEUCentral, "strict_measurements", true)

		// Create a test to verify that attestation with AP and US registrations, 
		// but using EU's new policy, should still pass in AP and US but fail in EU
		newEnclaveID := make([]byte, 32)
		newMeasurement := make([]byte, 32)
		rand.Read(newEnclaveID)
		rand.Read(newMeasurement)

		// Only register in US and AP
		usRegistry.RegisterTEE(newEnclaveID, newMeasurement)
		usRegistry.RegisterTEEInAccumulator(newEnclaveID, newMeasurement)
		// Propagate only to AP, not to EU
		network.PropagateAccumulator(RegionUSEast, RegionAPSouth, newEnclaveID, newMeasurement, 5)

		// Create a policy-compliant attestation
		policyAttestation := createTestDualAttestation()
		policyAttestation.EnclaveID = newEnclaveID
		policyAttestation.Measurement = newMeasurement
		policyAttestation.CrossSignature = make([]byte, 64)
		rand.Read(policyAttestation.CrossSignature)
		policyAttestation.Data = []byte("standard_execution=true;transaction=555")

		// Test in US - should pass
		policyAttestation.RegionID = RegionUSEast
		usResult, usErr := usVerifier.Verify(policyAttestation)
		assert.True(t, usResult, "Policy attestation should pass in US region")
		assert.NoError(t, usErr, "No error expected in US region")

		// Test in AP - should pass
		policyAttestation.RegionID = RegionAPSouth
		apResult, apErr := apVerifier.Verify(policyAttestation)
		assert.True(t, apResult, "Policy attestation should pass in AP region")
		assert.NoError(t, apErr, "No error expected in AP region")

		// Test in EU - should fail as not registered in EU and EU has stricter policy
		policyAttestation.RegionID = RegionEUCentral
		euResult, euErr := euVerifier.Verify(policyAttestation)
		assert.False(t, euResult, "Policy attestation should fail in EU region")
		assert.Error(t, euErr, "Error expected in EU region due to missing registration")
	})
}
	// Verify that the difference is within threshold
	assert.LessOrEqual(t, diffCount, maxDivergence, 
		"Accumulator difference exceeds maximum allowed divergence")

	// Verify attestations in both regions
	usResult, usErr := usVerifier.Verify(usAttestation)
	euResult, euErr := euVerifier.Verify(euAttestation)

	// Both verifications should pass because the difference is within threshold
	assert.True(t, usResult, "US verification should pass")
	assert.NoError(t, usErr, "US verification should not error")
	assert.True(t, euResult, "EU verification should pass")
	assert.NoError(t, euErr, "EU verification should not error")

	// Now simulate a significant difference (exceeding threshold)
	significantlyModifiedAccValue := make([]byte, len(originalAccValue))
	copy(significantlyModifiedAccValue, originalAccValue)
	// Modify multiple bytes to exceed threshold
	for i := 0; i < maxDivergence+2; i++ {
		significantlyModifiedAccValue[i] = byte(i + 1)
	}

// TestCrossRegionalPolicyPropagation tests that regional policies are correctly enforced
// during TEE attestation propagation across regions with different policy requirements
func TestCrossRegionalPolicyPropagation(t *testing.T) {
	// Create a multi-region network with three regions having different policy requirements
	network := NewMultiRegionNetwork(RegionUSEast, RegionEUCentral, RegionAPSouth)
	network.ConfigureCrossRegionalVerification()

	// Get registries for each region
	usRegistry := network.GetRegistry(RegionUSEast)
	euRegistry := network.GetRegistry(RegionEUCentral)
	apRegistry := network.GetRegistry(RegionAPSouth)

	// Create verifiers for each region
	usVerifier := NewAttestationVerifier(usRegistry)
	euVerifier := NewAttestationVerifier(euRegistry)
	apVerifier := NewAttestationVerifier(apRegistry)

	// Configure regional policies with different requirements
	// 1. EU requires dual attestation
	euRegistry.SetRegionalPolicy(RegionEUCentral, PolicyRequireDualAttestation, true)
	// 2. AP disallows external execution
	apRegistry.SetRegionalPolicy(RegionAPSouth, PolicyAllowExternalExecution, false)
	// 3. US allows both single attestation and external execution
	usRegistry.SetRegionalPolicy(RegionUSEast, PolicyRequireDualAttestation, false)
	usRegistry.SetRegionalPolicy(RegionUSEast, PolicyAllowExternalExecution, true)

	// Register a test TEE in the US region
	baseEnclaveID := make([]byte, 32)
	baseMeasurement := make([]byte, 32)
	rand.Read(baseEnclaveID)
	rand.Read(baseMeasurement)

	usRegistry.RegisterTEE(baseEnclaveID, baseMeasurement)
	usRegistry.RegisterTEEInAccumulator(baseEnclaveID, baseMeasurement)

	// TEST CASE 1: TEE Propagation with Single Attestation
	t.Run("SingleAttestationPropagation", func(t *testing.T) {
		// Create a single attestation for the US region
		singleAttestation := createTestSGXAttestation()
		singleAttestation.EnclaveID = baseEnclaveID
		singleAttestation.Measurement = baseMeasurement
		singleAttestation.RegionID = RegionUSEast

		// Verify in US region - should pass
		usResult, usErr := usVerifier.Verify(singleAttestation)
		assert.True(t, usResult, "Single attestation should pass in US region")
		assert.NoError(t, usErr, "No error expected for single attestation in US region")

		// Propagate the TEE to EU region
		network.PropagateAccumulator(RegionUSEast, RegionEUCentral, baseEnclaveID, baseMeasurement, 10)

		// The accumulator is now updated in EU region, but the single attestation should still fail
		// due to EU region's dual attestation policy
		singleAttestation.RegionID = RegionEUCentral
		euResult, euErr := euVerifier.Verify(singleAttestation)
		assert.False(t, euResult, "Single attestation should fail in EU region despite accumulator propagation")
		assert.Error(t, euErr, "Error expected for single attestation in EU region")
		assert.Contains(t, euErr.Error(), "dual attestation", "Error should indicate dual attestation requirement")

		// Create a dual attestation that should pass in EU
		dualAttestation := createTestDualAttestation()
		dualAttestation.EnclaveID = baseEnclaveID
		dualAttestation.Measurement = baseMeasurement
		dualAttestation.RegionID = RegionEUCentral
		dualAttestation.CrossSignature = make([]byte, 64) // Add cross-signature
		rand.Read(dualAttestation.CrossSignature)

		// Verify in EU region with dual attestation - should pass
		euResult, euErr = euVerifier.Verify(dualAttestation)
		assert.True(t, euResult, "Dual attestation should pass in EU region")
		assert.NoError(t, euErr, "No error expected for dual attestation in EU region")
	})

	// TEST CASE 2: External Execution Propagation
	t.Run("ExternalExecutionPropagation", func(t *testing.T) {
		// Create an external execution attestation for the US region
		externalAttestation := createTestSGXAttestation()
		externalAttestation.EnclaveID = baseEnclaveID
		externalAttestation.Measurement = baseMeasurement
		externalAttestation.RegionID = RegionUSEast
		externalAttestation.Data = []byte("external_execution=true;transaction=123")

		// Verify in US region - should pass as US allows external execution
		usResult, usErr := usVerifier.Verify(externalAttestation)
		assert.True(t, usResult, "External execution should pass in US region")
		assert.NoError(t, usErr, "No error expected for external execution in US region")

		// Propagate the TEE to AP region
		network.PropagateAccumulator(RegionUSEast, RegionAPSouth, baseEnclaveID, baseMeasurement, 15)

		// The accumulator is now updated in AP region, but the external execution attestation should fail
		// due to AP region's policy against external execution
		externalAttestation.RegionID = RegionAPSouth
		apResult, apErr := apVerifier.Verify(externalAttestation)
		assert.False(t, apResult, "External execution should fail in AP region despite accumulator propagation")
		assert.Error(t, apErr, "Error expected for external execution in AP region")
		assert.Contains(t, apErr.Error(), "external execution", "Error should indicate external execution restriction")

		// Create a standard attestation without external execution
		standardAttestation := createTestSGXAttestation()
		standardAttestation.EnclaveID = baseEnclaveID
		standardAttestation.Measurement = baseMeasurement
		standardAttestation.RegionID = RegionAPSouth
		standardAttestation.Data = []byte("standard_execution=true;transaction=123")

		// Verify in AP region without external execution - should pass
		apResult, apErr = apVerifier.Verify(standardAttestation)
		assert.True(t, apResult, "Standard execution should pass in AP region")
		assert.NoError(t, apErr, "No error expected for standard execution in AP region")
	})

	// TEST CASE 3: Cross-Regional Policy Consistency
	t.Run("CrossRegionalPolicyConsistency", func(t *testing.T) {
		// Create a multi-region TEE that needs to be valid in all regions
		multiRegionEnclaveID := make([]byte, 32)
		multiRegionMeasurement := make([]byte, 32)
		rand.Read(multiRegionEnclaveID)
		rand.Read(multiRegionMeasurement)

		// Register in all regions
		for _, registry := range []*MockTEERegistry{usRegistry, euRegistry, apRegistry} {
			registry.RegisterTEE(multiRegionEnclaveID, multiRegionMeasurement)
			registry.RegisterTEEInAccumulator(multiRegionEnclaveID, multiRegionMeasurement)
		}

		// Create an attestation that should be valid in all regions
		// It must be dual attestation (for EU) and avoid external execution (for AP)
		universalAttestation := createTestDualAttestation()
		universalAttestation.EnclaveID = multiRegionEnclaveID
		universalAttestation.Measurement = multiRegionMeasurement
		universalAttestation.CrossSignature = make([]byte, 64)
		rand.Read(universalAttestation.CrossSignature)
		universalAttestation.Data = []byte("standard_execution=true;transaction=999")

		// Check in all regions
		for regionID, verifier := range map[string]*AttestationVerifier{
			RegionUSEast:    usVerifier,
			RegionEUCentral: euVerifier,
			RegionAPSouth:   apVerifier,
		} {
			universalAttestation.RegionID = regionID
			result, err := verifier.Verify(universalAttestation)
			assert.True(t, result, "Universal attestation should pass in %s region", regionID)
			assert.NoError(t, err, "No error expected for universal attestation in %s region", regionID)
		}

		// Simulate a latency-induced accumulator update issue
		// When one region updates its policies but propagation hasn't completed
		// Set a new stricter policy in EU region
		euRegistry.SetRegionalPolicy(RegionEUCentral, "strict_measurements", true)

		// Create a test to verify that attestation with AP and US registrations, 
		// but using EU's new policy, should still pass in AP and US but fail in EU
		newEnclaveID := make([]byte, 32)
		newMeasurement := make([]byte, 32)
		rand.Read(newEnclaveID)
		rand.Read(newMeasurement)

		// Only register in US and AP
		usRegistry.RegisterTEE(newEnclaveID, newMeasurement)
		usRegistry.RegisterTEEInAccumulator(newEnclaveID, newMeasurement)
		// Propagate only to AP, not to EU
		network.PropagateAccumulator(RegionUSEast, RegionAPSouth, newEnclaveID, newMeasurement, 5)

		// Create a policy-compliant attestation
		policyAttestation := createTestDualAttestation()
		policyAttestation.EnclaveID = newEnclaveID
		policyAttestation.Measurement = newMeasurement
		policyAttestation.CrossSignature = make([]byte, 64)
		rand.Read(policyAttestation.CrossSignature)
		policyAttestation.Data = []byte("standard_execution=true;transaction=555")

		// Test in US - should pass
		policyAttestation.RegionID = RegionUSEast
		usResult, usErr := usVerifier.Verify(policyAttestation)
		assert.True(t, usResult, "Policy attestation should pass in US region")
		assert.NoError(t, usErr, "No error expected in US region")

		// Test in AP - should pass
		policyAttestation.RegionID = RegionAPSouth
		apResult, apErr := apVerifier.Verify(policyAttestation)
		assert.True(t, apResult, "Policy attestation should pass in AP region")
		assert.NoError(t, apErr, "No error expected in AP region")

		// Test in EU - should fail as not registered in EU and EU has stricter policy
		policyAttestation.RegionID = RegionEUCentral
		euResult, euErr := euVerifier.Verify(policyAttestation)
		assert.False(t, euResult, "Policy attestation should fail in EU region")
		assert.Error(t, euErr, "Error expected in EU region due to missing registration")
	})
}
	// Update EU accumulator with significant difference
	euRegistry.accumulatorTEEs[string(enclaveID)] = significantlyModifiedAccValue

	// Recalculate difference
	diffCount = 0
	for i := 0; i < len(originalAccValue); i++ {
		if originalAccValue[i] != significantlyModifiedAccValue[i] {
			diffCount++
		}

// TestCrossRegionalPolicyPropagation tests that regional policies are correctly enforced
// during TEE attestation propagation across regions with different policy requirements
func TestCrossRegionalPolicyPropagation(t *testing.T) {
	// Create a multi-region network with three regions having different policy requirements
	network := NewMultiRegionNetwork(RegionUSEast, RegionEUCentral, RegionAPSouth)
	network.ConfigureCrossRegionalVerification()

	// Get registries for each region
	usRegistry := network.GetRegistry(RegionUSEast)
	euRegistry := network.GetRegistry(RegionEUCentral)
	apRegistry := network.GetRegistry(RegionAPSouth)

	// Create verifiers for each region
	usVerifier := NewAttestationVerifier(usRegistry)
	euVerifier := NewAttestationVerifier(euRegistry)
	apVerifier := NewAttestationVerifier(apRegistry)

	// Configure regional policies with different requirements
	// 1. EU requires dual attestation
	euRegistry.SetRegionalPolicy(RegionEUCentral, PolicyRequireDualAttestation, true)
	// 2. AP disallows external execution
	apRegistry.SetRegionalPolicy(RegionAPSouth, PolicyAllowExternalExecution, false)
	// 3. US allows both single attestation and external execution
	usRegistry.SetRegionalPolicy(RegionUSEast, PolicyRequireDualAttestation, false)
	usRegistry.SetRegionalPolicy(RegionUSEast, PolicyAllowExternalExecution, true)

	// Register a test TEE in the US region
	baseEnclaveID := make([]byte, 32)
	baseMeasurement := make([]byte, 32)
	rand.Read(baseEnclaveID)
	rand.Read(baseMeasurement)

	usRegistry.RegisterTEE(baseEnclaveID, baseMeasurement)
	usRegistry.RegisterTEEInAccumulator(baseEnclaveID, baseMeasurement)

	// TEST CASE 1: TEE Propagation with Single Attestation
	t.Run("SingleAttestationPropagation", func(t *testing.T) {
		// Create a single attestation for the US region
		singleAttestation := createTestSGXAttestation()
		singleAttestation.EnclaveID = baseEnclaveID
		singleAttestation.Measurement = baseMeasurement
		singleAttestation.RegionID = RegionUSEast

		// Verify in US region - should pass
		usResult, usErr := usVerifier.Verify(singleAttestation)
		assert.True(t, usResult, "Single attestation should pass in US region")
		assert.NoError(t, usErr, "No error expected for single attestation in US region")

		// Propagate the TEE to EU region
		network.PropagateAccumulator(RegionUSEast, RegionEUCentral, baseEnclaveID, baseMeasurement, 10)

		// The accumulator is now updated in EU region, but the single attestation should still fail
		// due to EU region's dual attestation policy
		singleAttestation.RegionID = RegionEUCentral
		euResult, euErr := euVerifier.Verify(singleAttestation)
		assert.False(t, euResult, "Single attestation should fail in EU region despite accumulator propagation")
		assert.Error(t, euErr, "Error expected for single attestation in EU region")
		assert.Contains(t, euErr.Error(), "dual attestation", "Error should indicate dual attestation requirement")

		// Create a dual attestation that should pass in EU
		dualAttestation := createTestDualAttestation()
		dualAttestation.EnclaveID = baseEnclaveID
		dualAttestation.Measurement = baseMeasurement
		dualAttestation.RegionID = RegionEUCentral
		dualAttestation.CrossSignature = make([]byte, 64) // Add cross-signature
		rand.Read(dualAttestation.CrossSignature)

		// Verify in EU region with dual attestation - should pass
		euResult, euErr = euVerifier.Verify(dualAttestation)
		assert.True(t, euResult, "Dual attestation should pass in EU region")
		assert.NoError(t, euErr, "No error expected for dual attestation in EU region")
	})

	// TEST CASE 2: External Execution Propagation
	t.Run("ExternalExecutionPropagation", func(t *testing.T) {
		// Create an external execution attestation for the US region
		externalAttestation := createTestSGXAttestation()
		externalAttestation.EnclaveID = baseEnclaveID
		externalAttestation.Measurement = baseMeasurement
		externalAttestation.RegionID = RegionUSEast
		externalAttestation.Data = []byte("external_execution=true;transaction=123")

		// Verify in US region - should pass as US allows external execution
		usResult, usErr := usVerifier.Verify(externalAttestation)
		assert.True(t, usResult, "External execution should pass in US region")
		assert.NoError(t, usErr, "No error expected for external execution in US region")

		// Propagate the TEE to AP region
		network.PropagateAccumulator(RegionUSEast, RegionAPSouth, baseEnclaveID, baseMeasurement, 15)

		// The accumulator is now updated in AP region, but the external execution attestation should fail
		// due to AP region's policy against external execution
		externalAttestation.RegionID = RegionAPSouth
		apResult, apErr := apVerifier.Verify(externalAttestation)
		assert.False(t, apResult, "External execution should fail in AP region despite accumulator propagation")
		assert.Error(t, apErr, "Error expected for external execution in AP region")
		assert.Contains(t, apErr.Error(), "external execution", "Error should indicate external execution restriction")

		// Create a standard attestation without external execution
		standardAttestation := createTestSGXAttestation()
		standardAttestation.EnclaveID = baseEnclaveID
		standardAttestation.Measurement = baseMeasurement
		standardAttestation.RegionID = RegionAPSouth
		standardAttestation.Data = []byte("standard_execution=true;transaction=123")

		// Verify in AP region without external execution - should pass
		apResult, apErr = apVerifier.Verify(standardAttestation)
		assert.True(t, apResult, "Standard execution should pass in AP region")
		assert.NoError(t, apErr, "No error expected for standard execution in AP region")
	})

	// TEST CASE 3: Cross-Regional Policy Consistency
	t.Run("CrossRegionalPolicyConsistency", func(t *testing.T) {
		// Create a multi-region TEE that needs to be valid in all regions
		multiRegionEnclaveID := make([]byte, 32)
		multiRegionMeasurement := make([]byte, 32)
		rand.Read(multiRegionEnclaveID)
		rand.Read(multiRegionMeasurement)

		// Register in all regions
		for _, registry := range []*MockTEERegistry{usRegistry, euRegistry, apRegistry} {
			registry.RegisterTEE(multiRegionEnclaveID, multiRegionMeasurement)
			registry.RegisterTEEInAccumulator(multiRegionEnclaveID, multiRegionMeasurement)
		}

		// Create an attestation that should be valid in all regions
		// It must be dual attestation (for EU) and avoid external execution (for AP)
		universalAttestation := createTestDualAttestation()
		universalAttestation.EnclaveID = multiRegionEnclaveID
		universalAttestation.Measurement = multiRegionMeasurement
		universalAttestation.CrossSignature = make([]byte, 64)
		rand.Read(universalAttestation.CrossSignature)
		universalAttestation.Data = []byte("standard_execution=true;transaction=999")

		// Check in all regions
		for regionID, verifier := range map[string]*AttestationVerifier{
			RegionUSEast:    usVerifier,
			RegionEUCentral: euVerifier,
			RegionAPSouth:   apVerifier,
		} {
			universalAttestation.RegionID = regionID
			result, err := verifier.Verify(universalAttestation)
			assert.True(t, result, "Universal attestation should pass in %s region", regionID)
			assert.NoError(t, err, "No error expected for universal attestation in %s region", regionID)
		}

		// Simulate a latency-induced accumulator update issue
		// When one region updates its policies but propagation hasn't completed
		// Set a new stricter policy in EU region
		euRegistry.SetRegionalPolicy(RegionEUCentral, "strict_measurements", true)

		// Create a test to verify that attestation with AP and US registrations, 
		// but using EU's new policy, should still pass in AP and US but fail in EU
		newEnclaveID := make([]byte, 32)
		newMeasurement := make([]byte, 32)
		rand.Read(newEnclaveID)
		rand.Read(newMeasurement)

		// Only register in US and AP
		usRegistry.RegisterTEE(newEnclaveID, newMeasurement)
		usRegistry.RegisterTEEInAccumulator(newEnclaveID, newMeasurement)
		// Propagate only to AP, not to EU
		network.PropagateAccumulator(RegionUSEast, RegionAPSouth, newEnclaveID, newMeasurement, 5)

		// Create a policy-compliant attestation
		policyAttestation := createTestDualAttestation()
		policyAttestation.EnclaveID = newEnclaveID
		policyAttestation.Measurement = newMeasurement
		policyAttestation.CrossSignature = make([]byte, 64)
		rand.Read(policyAttestation.CrossSignature)
		policyAttestation.Data = []byte("standard_execution=true;transaction=555")

		// Test in US - should pass
		policyAttestation.RegionID = RegionUSEast
		usResult, usErr := usVerifier.Verify(policyAttestation)
		assert.True(t, usResult, "Policy attestation should pass in US region")
		assert.NoError(t, usErr, "No error expected in US region")

		// Test in AP - should pass
		policyAttestation.RegionID = RegionAPSouth
		apResult, apErr := apVerifier.Verify(policyAttestation)
		assert.True(t, apResult, "Policy attestation should pass in AP region")
		assert.NoError(t, apErr, "No error expected in AP region")

		// Test in EU - should fail as not registered in EU and EU has stricter policy
		policyAttestation.RegionID = RegionEUCentral
		euResult, euErr := euVerifier.Verify(policyAttestation)
		assert.False(t, euResult, "Policy attestation should fail in EU region")
		assert.Error(t, euErr, "Error expected in EU region due to missing registration")
	})
}	}

// TestCrossRegionalPolicyPropagation tests that regional policies are correctly enforced
// during TEE attestation propagation across regions with different policy requirements
func TestCrossRegionalPolicyPropagation(t *testing.T) {
	// Create a multi-region network with three regions having different policy requirements
	network := NewMultiRegionNetwork(RegionUSEast, RegionEUCentral, RegionAPSouth)
	network.ConfigureCrossRegionalVerification()

	// Get registries for each region
	usRegistry := network.GetRegistry(RegionUSEast)
	euRegistry := network.GetRegistry(RegionEUCentral)
	apRegistry := network.GetRegistry(RegionAPSouth)

	// Create verifiers for each region
	usVerifier := NewAttestationVerifier(usRegistry)
	euVerifier := NewAttestationVerifier(euRegistry)
	apVerifier := NewAttestationVerifier(apRegistry)

	// Configure regional policies with different requirements
	// 1. EU requires dual attestation
	euRegistry.SetRegionalPolicy(RegionEUCentral, PolicyRequireDualAttestation, true)
	// 2. AP disallows external execution
	apRegistry.SetRegionalPolicy(RegionAPSouth, PolicyAllowExternalExecution, false)
	// 3. US allows both single attestation and external execution
	usRegistry.SetRegionalPolicy(RegionUSEast, PolicyRequireDualAttestation, false)
	usRegistry.SetRegionalPolicy(RegionUSEast, PolicyAllowExternalExecution, true)

	// Register a test TEE in the US region
	baseEnclaveID := make([]byte, 32)
	baseMeasurement := make([]byte, 32)
	rand.Read(baseEnclaveID)
	rand.Read(baseMeasurement)

	usRegistry.RegisterTEE(baseEnclaveID, baseMeasurement)
	usRegistry.RegisterTEEInAccumulator(baseEnclaveID, baseMeasurement)

	// TEST CASE 1: TEE Propagation with Single Attestation
	t.Run("SingleAttestationPropagation", func(t *testing.T) {
		// Create a single attestation for the US region
		singleAttestation := createTestSGXAttestation()
		singleAttestation.EnclaveID = baseEnclaveID
		singleAttestation.Measurement = baseMeasurement
		singleAttestation.RegionID = RegionUSEast

		// Verify in US region - should pass
		usResult, usErr := usVerifier.Verify(singleAttestation)
		assert.True(t, usResult, "Single attestation should pass in US region")
		assert.NoError(t, usErr, "No error expected for single attestation in US region")

		// Propagate the TEE to EU region
		network.PropagateAccumulator(RegionUSEast, RegionEUCentral, baseEnclaveID, baseMeasurement, 10)

		// The accumulator is now updated in EU region, but the single attestation should still fail
		// due to EU region's dual attestation policy
		singleAttestation.RegionID = RegionEUCentral
		euResult, euErr := euVerifier.Verify(singleAttestation)
		assert.False(t, euResult, "Single attestation should fail in EU region despite accumulator propagation")
		assert.Error(t, euErr, "Error expected for single attestation in EU region")
		assert.Contains(t, euErr.Error(), "dual attestation", "Error should indicate dual attestation requirement")

		// Create a dual attestation that should pass in EU
		dualAttestation := createTestDualAttestation()
		dualAttestation.EnclaveID = baseEnclaveID
		dualAttestation.Measurement = baseMeasurement
		dualAttestation.RegionID = RegionEUCentral
		dualAttestation.CrossSignature = make([]byte, 64) // Add cross-signature
		rand.Read(dualAttestation.CrossSignature)

		// Verify in EU region with dual attestation - should pass
		euResult, euErr = euVerifier.Verify(dualAttestation)
		assert.True(t, euResult, "Dual attestation should pass in EU region")
		assert.NoError(t, euErr, "No error expected for dual attestation in EU region")
	})

	// TEST CASE 2: External Execution Propagation
	t.Run("ExternalExecutionPropagation", func(t *testing.T) {
		// Create an external execution attestation for the US region
		externalAttestation := createTestSGXAttestation()
		externalAttestation.EnclaveID = baseEnclaveID
		externalAttestation.Measurement = baseMeasurement
		externalAttestation.RegionID = RegionUSEast
		externalAttestation.Data = []byte("external_execution=true;transaction=123")

		// Verify in US region - should pass as US allows external execution
		usResult, usErr := usVerifier.Verify(externalAttestation)
		assert.True(t, usResult, "External execution should pass in US region")
		assert.NoError(t, usErr, "No error expected for external execution in US region")

		// Propagate the TEE to AP region
		network.PropagateAccumulator(RegionUSEast, RegionAPSouth, baseEnclaveID, baseMeasurement, 15)

		// The accumulator is now updated in AP region, but the external execution attestation should fail
		// due to AP region's policy against external execution
		externalAttestation.RegionID = RegionAPSouth
		apResult, apErr := apVerifier.Verify(externalAttestation)
		assert.False(t, apResult, "External execution should fail in AP region despite accumulator propagation")
		assert.Error(t, apErr, "Error expected for external execution in AP region")
		assert.Contains(t, apErr.Error(), "external execution", "Error should indicate external execution restriction")

		// Create a standard attestation without external execution
		standardAttestation := createTestSGXAttestation()
		standardAttestation.EnclaveID = baseEnclaveID
		standardAttestation.Measurement = baseMeasurement
		standardAttestation.RegionID = RegionAPSouth
		standardAttestation.Data = []byte("standard_execution=true;transaction=123")

		// Verify in AP region without external execution - should pass
		apResult, apErr = apVerifier.Verify(standardAttestation)
		assert.True(t, apResult, "Standard execution should pass in AP region")
		assert.NoError(t, apErr, "No error expected for standard execution in AP region")
	})

	// TEST CASE 3: Cross-Regional Policy Consistency
	t.Run("CrossRegionalPolicyConsistency", func(t *testing.T) {
		// Create a multi-region TEE that needs to be valid in all regions
		multiRegionEnclaveID := make([]byte, 32)
		multiRegionMeasurement := make([]byte, 32)
		rand.Read(multiRegionEnclaveID)
		rand.Read(multiRegionMeasurement)

		// Register in all regions
		for _, registry := range []*MockTEERegistry{usRegistry, euRegistry, apRegistry} {
			registry.RegisterTEE(multiRegionEnclaveID, multiRegionMeasurement)
			registry.RegisterTEEInAccumulator(multiRegionEnclaveID, multiRegionMeasurement)
		}

		// Create an attestation that should be valid in all regions
		// It must be dual attestation (for EU) and avoid external execution (for AP)
		universalAttestation := createTestDualAttestation()
		universalAttestation.EnclaveID = multiRegionEnclaveID
		universalAttestation.Measurement = multiRegionMeasurement
		universalAttestation.CrossSignature = make([]byte, 64)
		rand.Read(universalAttestation.CrossSignature)
		universalAttestation.Data = []byte("standard_execution=true;transaction=999")

		// Check in all regions
		for regionID, verifier := range map[string]*AttestationVerifier{
			RegionUSEast:    usVerifier,
			RegionEUCentral: euVerifier,
			RegionAPSouth:   apVerifier,
		} {
			universalAttestation.RegionID = regionID
			result, err := verifier.Verify(universalAttestation)
			assert.True(t, result, "Universal attestation should pass in %s region", regionID)
			assert.NoError(t, err, "No error expected for universal attestation in %s region", regionID)
		}

		// Simulate a latency-induced accumulator update issue
		// When one region updates its policies but propagation hasn't completed
		// Set a new stricter policy in EU region
		euRegistry.SetRegionalPolicy(RegionEUCentral, "strict_measurements", true)

		// Create a test to verify that attestation with AP and US registrations, 
		// but using EU's new policy, should still pass in AP and US but fail in EU
		newEnclaveID := make([]byte, 32)
		newMeasurement := make([]byte, 32)
		rand.Read(newEnclaveID)
		rand.Read(newMeasurement)

		// Only register in US and AP
		usRegistry.RegisterTEE(newEnclaveID, newMeasurement)
		usRegistry.RegisterTEEInAccumulator(newEnclaveID, newMeasurement)
		// Propagate only to AP, not to EU
		network.PropagateAccumulator(RegionUSEast, RegionAPSouth, newEnclaveID, newMeasurement, 5)

		// Create a policy-compliant attestation
		policyAttestation := createTestDualAttestation()
		policyAttestation.EnclaveID = newEnclaveID
		policyAttestation.Measurement = newMeasurement
		policyAttestation.CrossSignature = make([]byte, 64)
		rand.Read(policyAttestation.CrossSignature)
		policyAttestation.Data = []byte("standard_execution=true;transaction=555")

		// Test in US - should pass
		policyAttestation.RegionID = RegionUSEast
		usResult, usErr := usVerifier.Verify(policyAttestation)
		assert.True(t, usResult, "Policy attestation should pass in US region")
		assert.NoError(t, usErr, "No error expected in US region")

		// Test in AP - should pass
		policyAttestation.RegionID = RegionAPSouth
		apResult, apErr := apVerifier.Verify(policyAttestation)
		assert.True(t, apResult, "Policy attestation should pass in AP region")
		assert.NoError(t, apErr, "No error expected in AP region")

		// Test in EU - should fail as not registered in EU and EU has stricter policy
		policyAttestation.RegionID = RegionEUCentral
		euResult, euErr := euVerifier.Verify(policyAttestation)
		assert.False(t, euResult, "Policy attestation should fail in EU region")
		assert.Error(t, euErr, "Error expected in EU region due to missing registration")
	})
}
	// Verify the difference exceeds threshold
	assert.Greater(t, diffCount, maxDivergence, 
		"Modified accumulator should exceed maximum allowed divergence")

	// When an attestation with significant accumulator difference is presented,
	// it should fail verification at the consistency check stage
	tamperAttestation := createTestAttestationWithAccumulator()
	tamperAttestation.EnclaveID = enclaveID
	tamperAttestation.Measurement = measurement
	tamperAttestation.RegionID = RegionEUCentral

	// Manually set accumulator value that doesn't match expected
	if tamperAttestation.StateProof != nil {
		tamperAttestation.StateProof.AccumulatorValue = significantlyModifiedAccValue
	} else {
		// Create a state proof if it doesn't exist
		tamperAttestation.StateProof = &StateTransitionProof{
			Type:             AccumulatorProof,
			AccumulatorValue: significantlyModifiedAccValue,
		}

// TestCrossRegionalPolicyPropagation tests that regional policies are correctly enforced
// during TEE attestation propagation across regions with different policy requirements
func TestCrossRegionalPolicyPropagation(t *testing.T) {
	// Create a multi-region network with three regions having different policy requirements
	network := NewMultiRegionNetwork(RegionUSEast, RegionEUCentral, RegionAPSouth)
	network.ConfigureCrossRegionalVerification()

	// Get registries for each region
	usRegistry := network.GetRegistry(RegionUSEast)
	euRegistry := network.GetRegistry(RegionEUCentral)
	apRegistry := network.GetRegistry(RegionAPSouth)

	// Create verifiers for each region
	usVerifier := NewAttestationVerifier(usRegistry)
	euVerifier := NewAttestationVerifier(euRegistry)
	apVerifier := NewAttestationVerifier(apRegistry)

	// Configure regional policies with different requirements
	// 1. EU requires dual attestation
	euRegistry.SetRegionalPolicy(RegionEUCentral, PolicyRequireDualAttestation, true)
	// 2. AP disallows external execution
	apRegistry.SetRegionalPolicy(RegionAPSouth, PolicyAllowExternalExecution, false)
	// 3. US allows both single attestation and external execution
	usRegistry.SetRegionalPolicy(RegionUSEast, PolicyRequireDualAttestation, false)
	usRegistry.SetRegionalPolicy(RegionUSEast, PolicyAllowExternalExecution, true)

	// Register a test TEE in the US region
	baseEnclaveID := make([]byte, 32)
	baseMeasurement := make([]byte, 32)
	rand.Read(baseEnclaveID)
	rand.Read(baseMeasurement)

	usRegistry.RegisterTEE(baseEnclaveID, baseMeasurement)
	usRegistry.RegisterTEEInAccumulator(baseEnclaveID, baseMeasurement)

	// TEST CASE 1: TEE Propagation with Single Attestation
	t.Run("SingleAttestationPropagation", func(t *testing.T) {
		// Create a single attestation for the US region
		singleAttestation := createTestSGXAttestation()
		singleAttestation.EnclaveID = baseEnclaveID
		singleAttestation.Measurement = baseMeasurement
		singleAttestation.RegionID = RegionUSEast

		// Verify in US region - should pass
		usResult, usErr := usVerifier.Verify(singleAttestation)
		assert.True(t, usResult, "Single attestation should pass in US region")
		assert.NoError(t, usErr, "No error expected for single attestation in US region")

		// Propagate the TEE to EU region
		network.PropagateAccumulator(RegionUSEast, RegionEUCentral, baseEnclaveID, baseMeasurement, 10)

		// The accumulator is now updated in EU region, but the single attestation should still fail
		// due to EU region's dual attestation policy
		singleAttestation.RegionID = RegionEUCentral
		euResult, euErr := euVerifier.Verify(singleAttestation)
		assert.False(t, euResult, "Single attestation should fail in EU region despite accumulator propagation")
		assert.Error(t, euErr, "Error expected for single attestation in EU region")
		assert.Contains(t, euErr.Error(), "dual attestation", "Error should indicate dual attestation requirement")

		// Create a dual attestation that should pass in EU
		dualAttestation := createTestDualAttestation()
		dualAttestation.EnclaveID = baseEnclaveID
		dualAttestation.Measurement = baseMeasurement
		dualAttestation.RegionID = RegionEUCentral
		dualAttestation.CrossSignature = make([]byte, 64) // Add cross-signature
		rand.Read(dualAttestation.CrossSignature)

		// Verify in EU region with dual attestation - should pass
		euResult, euErr = euVerifier.Verify(dualAttestation)
		assert.True(t, euResult, "Dual attestation should pass in EU region")
		assert.NoError(t, euErr, "No error expected for dual attestation in EU region")
	})

	// TEST CASE 2: External Execution Propagation
	t.Run("ExternalExecutionPropagation", func(t *testing.T) {
		// Create an external execution attestation for the US region
		externalAttestation := createTestSGXAttestation()
		externalAttestation.EnclaveID = baseEnclaveID
		externalAttestation.Measurement = baseMeasurement
		externalAttestation.RegionID = RegionUSEast
		externalAttestation.Data = []byte("external_execution=true;transaction=123")

		// Verify in US region - should pass as US allows external execution
		usResult, usErr := usVerifier.Verify(externalAttestation)
		assert.True(t, usResult, "External execution should pass in US region")
		assert.NoError(t, usErr, "No error expected for external execution in US region")

		// Propagate the TEE to AP region
		network.PropagateAccumulator(RegionUSEast, RegionAPSouth, baseEnclaveID, baseMeasurement, 15)

		// The accumulator is now updated in AP region, but the external execution attestation should fail
		// due to AP region's policy against external execution
		externalAttestation.RegionID = RegionAPSouth
		apResult, apErr := apVerifier.Verify(externalAttestation)
		assert.False(t, apResult, "External execution should fail in AP region despite accumulator propagation")
		assert.Error(t, apErr, "Error expected for external execution in AP region")
		assert.Contains(t, apErr.Error(), "external execution", "Error should indicate external execution restriction")

		// Create a standard attestation without external execution
		standardAttestation := createTestSGXAttestation()
		standardAttestation.EnclaveID = baseEnclaveID
		standardAttestation.Measurement = baseMeasurement
		standardAttestation.RegionID = RegionAPSouth
		standardAttestation.Data = []byte("standard_execution=true;transaction=123")

		// Verify in AP region without external execution - should pass
		apResult, apErr = apVerifier.Verify(standardAttestation)
		assert.True(t, apResult, "Standard execution should pass in AP region")
		assert.NoError(t, apErr, "No error expected for standard execution in AP region")
	})

	// TEST CASE 3: Cross-Regional Policy Consistency
	t.Run("CrossRegionalPolicyConsistency", func(t *testing.T) {
		// Create a multi-region TEE that needs to be valid in all regions
		multiRegionEnclaveID := make([]byte, 32)
		multiRegionMeasurement := make([]byte, 32)
		rand.Read(multiRegionEnclaveID)
		rand.Read(multiRegionMeasurement)

		// Register in all regions
		for _, registry := range []*MockTEERegistry{usRegistry, euRegistry, apRegistry} {
			registry.RegisterTEE(multiRegionEnclaveID, multiRegionMeasurement)
			registry.RegisterTEEInAccumulator(multiRegionEnclaveID, multiRegionMeasurement)
		}

		// Create an attestation that should be valid in all regions
		// It must be dual attestation (for EU) and avoid external execution (for AP)
