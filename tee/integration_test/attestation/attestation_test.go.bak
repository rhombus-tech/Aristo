// MockTEERegistry is a mock implementation of a TEE registry for testing
type MockTEERegistry struct {
	allowedRegions            []string
	regionMeasurements        map[string][]byte
	teeIDs                    map[string][]byte
	regionalPolicies          map[string]map[string]interface{}
	dcapSupported             bool
	accumulatorTEEs           map[string][]byte // For accumulator-based verification
	usedAttestations          map[string]bool   // For replay attack protection
	securityHeuristicsEnabled bool              // For security heuristics
	vulnerableMeasurements    map[string]string // For vulnerable measurement database
	timeserver                *SimpleTimeserver // For timeserver integration
}

// RegisterTEE registers a TEE in the registry
func (m *MockTEERegistry) RegisterTEE(enclaveID, measurement []byte) {
	// Convert binary enclaveID to string key
	idStr := hex.EncodeToString(enclaveID)
	if m.teeIDs == nil {
		m.teeIDs = make(map[string][]byte)
	}
	m.teeIDs[idStr] = enclaveID

	if m.accumulatorTEEs == nil {
		m.accumulatorTEEs = make(map[string][]byte)
	}
	m.accumulatorTEEs[idStr] = measurement
}

// RegisterTEEInAccumulator registers a TEE in the accumulator-based registry
func (m *MockTEERegistry) RegisterTEEInAccumulator(enclaveID, measurement []byte) {
	// This is a specialized version of RegisterTEE for accumulator-based verification
	m.RegisterTEE(enclaveID, measurement)
}

// AddRegionMeasurement adds a region-specific measurement requirement
func (m *MockTEERegistry) AddRegionMeasurement(regionID string, measurement []byte) {
	m.regionMeasurements[regionID] = measurement
}

// SetRegionalPolicy sets a specific policy for a region
func (m *MockTEERegistry) SetRegionalPolicy(regionID, policyName string, value interface{}) {
	if m.regionalPolicies[regionID] == nil {
		m.regionalPolicies[regionID] = make(map[string]interface{})
	}
	m.regionalPolicies[regionID][policyName] = value
}

// EnableDCAPSupport enables DCAP support in the mock registry
func (m *MockTEERegistry) EnableDCAPSupport(enabled bool) {
	m.dcapSupported = enabled
}

// These methods are defined in attestation_security_test.go
//
// EnableReplayProtection enables replay attack protection in the mock registry
// EnableSecurityHeuristics enables security heuristics in the mock registry
// We don't need to redefine this method as it's already defined in the security test file

// IsRegionAllowed checks if a region is allowed
func (m *MockTEERegistry) IsRegionAllowed(regionID string) bool {
	if m.allowedRegions == nil {
		return true
	}

	for _, region := range m.allowedRegions {
		if region == regionID {
			return true
		}
	}

	return false
}

// VerifyMeasurement verifies a TEE measurement
func (m *MockTEERegistry) VerifyMeasurement(enclaveID, measurement []byte, regionID string) bool {
	// Check if there's a region-specific measurement requirement
	if expectedMeasurement, ok := m.regionMeasurements[regionID]; ok {
		return bytes.Equal(measurement, expectedMeasurement)
	}

	// Also verify against accumulator-registered measurements
	idStr := string(enclaveID)
	if registeredMeasurement, ok := m.accumulatorTEEs[idStr]; ok {
		return bytes.Equal(measurement, registeredMeasurement)
	}

	// If no specific requirements, consider any valid measurement acceptable
	return len(measurement) == 32
}

// IsTEERegistered checks if a TEE is registered
func (m *MockTEERegistry) IsTEERegistered(enclaveID []byte) bool {
	idStr := string(enclaveID)
	_, registered := m.accumulatorTEEs[idStr]

	// For testing purposes, also consider any 32-byte ID as registered
	return registered || len(enclaveID) == 32
}

// CheckRegionalPolicy checks a specific policy for a region
func (m *MockTEERegistry) CheckRegionalPolicy(regionID, policyName string) (interface{}, bool) {
	if m.regionalPolicies == nil {
		return nil, false
	}

	regionPolicies, ok := m.regionalPolicies[regionID]
	if !ok {
		return nil, false
	}

	value, ok := regionPolicies[policyName]
	return value, ok
}

// IsDCAPSupported checks if DCAP is supported
func (m *MockTEERegistry) IsDCAPSupported() bool {
	return m.dcapSupported
}

// SimpleTimeserver is a streamlined timeserver for basic tests
type SimpleTimeserver struct {
	currentTime time.Time
	skew        time.Duration
}

// NewSimpleTimeserver creates a new simple timeserver
func NewSimpleTimeserver() *SimpleTimeserver {
	return &SimpleTimeserver{
		currentTime: time.Now(),
		skew:        0,
	}
}

// GetTime returns the current time from the timeserver
func (t *SimpleTimeserver) GetTime() time.Time {
	return t.currentTime
}

// SetSkew sets the time skew for the timeserver
func (t *SimpleTimeserver) SetSkew(skew time.Duration) {
	t.skew = skew
}

// ValidateTimestamp validates a timestamp against the timeserver
func (t *SimpleTimeserver) ValidateTimestamp(timestamp time.Time) bool {
	diff := t.currentTime.Sub(timestamp)
	if diff < 0 {
		diff = -diff
	}
	return diff <= t.skew
}

// VerifyWithTimeserver verifies an attestation with timeserver token
func (v *AttestationVerifier) VerifyWithTimeserver(attestation *Attestation) (bool, error) {
	// Basic attestation verification
	result, err := v.Verify(attestation)
	if !result || err != nil {
		return result, err
	}

	// Additional timeserver verification
	if attestation.TimestampToken != nil && len(attestation.TimestampToken) > 0 {
		// Verify timestamp token
		// This is a simplified implementation
	}

	return true, nil
}

// updateAccumulator simulates updating the accumulator with new transaction data
func updateAccumulator(txID []byte) []byte {
	// Create a simulated previous accumulator value
	accumulator := make([]byte, 32)
	// In a real implementation, this would be a cryptographic function
	// that updates the accumulator based on the transaction ID

	// For simulation, we'll use a simple hash
	hash := sha256.Sum256(txID)
	copy(accumulator, hash[:])

	return accumulator
}

// computeWitness simulates computing a witness for an accumulator value
func computeWitness(accumulator []byte) []byte {
	// Create a simulated witness
	witness := make([]byte, 64)
	// In a real implementation, this would compute a cryptographic witness
	// for verifying state transitions

	// For simulation, we'll use random bytes
	_, _ = rand.Read(witness)

	return witness
}

