// TestAttestationWithAccumulatorProof tests the complete verification path for an attestation with accumulator proof
func TestAttestationWithAccumulatorProof(t *testing.T) {
	// Setup test environment with mock TEEs
	mockRegistry := setupMockTEERegistry()
	verifier := NewAttestationVerifier(mockRegistry)

	// Create attestation with accumulator proof
	attestation := createTestAttestationWithAccumulator()

	// Register the TEE in the registry for testing
	mockRegistry.RegisterTEE(attestation.EnclaveID, attestation.Measurement)

	// Verify complete attestation path
	result, err := verifier.VerifyWithAccumulator(attestation)
	assert.NoError(t, err)
	assert.True(t, result)

	// Test with tampered accumulator proof
	tamperedAttestation := tamperAccumulatorProof(attestation)
	result, err = verifier.VerifyWithAccumulator(tamperedAttestation)
	assert.Error(t, err)
	assert.False(t, result)
	assert.Contains(t, err.Error(), "invalid accumulator value")
}

// TestDualAttestationVerification tests the verification of dual (SGX+SEV) attestations
func TestDualAttestationVerification(t *testing.T) {
	// Setup test environment with mock TEEs
	mockRegistry := setupMockTEERegistry()
	verifier := NewAttestationVerifier(mockRegistry)

	// Create a dual attestation (SGX + SEV)
	attestation := createTestDualAttestation()

	// Verify dual attestation
	result, err := verifier.Verify(attestation)
	assert.NoError(t, err)
	assert.True(t, result)

	// Test with missing cross-signature
	invalidAttestation := createTestDualAttestation()
	invalidAttestation.CrossSignature = nil
	result, err = verifier.Verify(invalidAttestation)
	assert.Error(t, err)
	assert.False(t, result)
	assert.Contains(t, err.Error(), "missing cross signature")
}

// TestRegionalAttestationCompliance tests attestation verification with region-specific rules
func TestRegionalAttestationCompliance(t *testing.T) {
	t.Run("Valid Region", func(t *testing.T) {
		attestation := createTestAttestationWithAccumulator()
		attestation.RegionID = "us-east"

		mockRegistry := setupMockTEERegistry()
		verifier := NewAttestationVerifier(mockRegistry)

		result, err := verifier.Verify(attestation)
		assert.NoError(t, err)
		assert.True(t, result)
	})

	t.Run("Invalid Region", func(t *testing.T) {
		attestation := createTestAttestationWithAccumulator()
		attestation.RegionID = "restricted-region"

		mockRegistry := setupMockTEERegistry()
		verifier := NewAttestationVerifier(mockRegistry)

		result, err := verifier.Verify(attestation)
		assert.Error(t, err)
		assert.False(t, result)
		assert.Contains(t, err.Error(), "region not allowed")
	})

	t.Run("Region-specific Measurement Requirements", func(t *testing.T) {
		attestation := createTestAttestationWithAccumulator()
		attestation.RegionID = "eu-central"

		// Create a specific measurement for EU region
		euMeasurement := make([]byte, 32)
		_, _ = rand.Read(euMeasurement)

		mockRegistry := setupMockTEERegistry()
		mockRegistry.AddRegionMeasurement("eu-central", euMeasurement)

		// Test with incorrect measurement
		attestation.Measurement = make([]byte, 32)
		_, _ = rand.Read(attestation.Measurement)

		verifier := NewAttestationVerifier(mockRegistry)
		result, err := verifier.Verify(attestation)
		assert.Error(t, err)
		assert.False(t, result)
		assert.Contains(t, err.Error(), "invalid measurement for region")

		// Test with correct measurement
		attestation.Measurement = euMeasurement
		result, err = verifier.Verify(attestation)
		assert.NoError(t, err)
		assert.True(t, result)
	})
}

// TestPerformanceOfAttestationVerification measures the performance of attestation verification
func TestPerformanceOfAttestationVerification(t *testing.T) {
	if testing.Short() {
		t.Skip("skipping performance test in short mode")
	}

	// Setup test environment with mock TEEs
	mockRegistry := setupMockTEERegistry()
	verifier := NewAttestationVerifier(mockRegistry)

	// Create a batch of attestations
	batchSize := 100
	attestations := make([]*Attestation, batchSize)
	for i := 0; i < batchSize; i++ {
		attestations[i] = createTestAttestationWithAccumulator()
	}

	// Measure verification time
	start := time.Now()
	for i := 0; i < batchSize; i++ {
		result, err := verifier.VerifyWithAccumulator(attestations[i])
		require.NoError(t, err)
		require.True(t, result)
	}
	elapsed := time.Since(start)

	// Calculate statistics
	averageTime := elapsed / time.Duration(batchSize)
	t.Logf("Verified %d attestations in %v", batchSize, elapsed)
	t.Logf("Average verification time: %v per attestation", averageTime)

	// Assert that verification meets performance target (sub-100ms)
	assert.Less(t, averageTime, 100*time.Millisecond, "Verification time exceeds target of 100ms")
}

// TestCrossRegionAttestationVerification tests verification of attestations across regions
func TestCrossRegionAttestationVerification(t *testing.T) {
	// Setup test registry with multiple regions
	mockRegistry := setupMultiRegionRegistry()
	verifier := NewAttestationVerifier(mockRegistry)

	// Create attestations from different regions
	usEastAttestation := createTestAttestationWithAccumulator()
	usEastAttestation.RegionID = "us-east"

	euCentralAttestation := createTestAttestationWithAccumulator()
	euCentralAttestation.RegionID = "eu-central"

	// Verify cross-region attestations
	result, err := verifier.Verify(usEastAttestation)
	assert.NoError(t, err)
	assert.True(t, result)

	result, err = verifier.Verify(euCentralAttestation)
	assert.NoError(t, err)
	assert.True(t, result)

	// Test cross-region verification with region-specific policies
	mockRegistry.SetRegionalPolicy("eu-central", "required-dual-attestation", true)

	// Single attestation should fail in a region requiring dual attestation
	singleAttestation := createTestSGXAttestation()
	singleAttestation.RegionID = "eu-central"
	result, err = verifier.Verify(singleAttestation)
	assert.Error(t, err)
	assert.False(t, result)
	assert.Contains(t, err.Error(), "dual attestation required")

	// Dual attestation should pass
	dualAttestation := createTestDualAttestation()
	dualAttestation.RegionID = "eu-central"
	result, err = verifier.Verify(dualAttestation)
	assert.NoError(t, err)
	assert.True(t, result)
}

// TestDCAPBootstrapThenMesh tests the hybrid DCAP + mesh verification approach
func TestDCAPBootstrapThenMesh(t *testing.T) {
	// Setup registry with DCAP support
	mockRegistry := setupMockTEERegistry()
	mockRegistry.EnableDCAPSupport(true)
	verifier := NewAttestationVerifier(mockRegistry)

	// Test DCAP bootstrap attestation (first attestation from a TEE)
	dcapAttestation := createTestDCAPAttestation()
	result, err := verifier.VerifyDCAPBootstrap(dcapAttestation)
	assert.NoError(t, err)
	assert.True(t, result)

	// Register the TEE in the accumulator
	mockRegistry.RegisterTEEInAccumulator(dcapAttestation.EnclaveID, dcapAttestation.Measurement)

	// Test subsequent mesh verification (using accumulator)
	meshAttestation := createTestAttestationWithAccumulator()
	meshAttestation.EnclaveID = dcapAttestation.EnclaveID
	meshAttestation.Measurement = dcapAttestation.Measurement

	result, err = verifier.VerifyWithAccumulator(meshAttestation)
	assert.NoError(t, err)
	assert.True(t, result)

	// Test with unregistered TEE (should fail mesh verification)
	newTEEAttestation := createTestAttestationWithAccumulator()
	unknownID := make([]byte, 32)
	_, _ = rand.Read(unknownID)
	newTEEAttestation.EnclaveID = unknownID

	result, err = verifier.VerifyWithAccumulator(newTEEAttestation)
	assert.False(t, result)
}

// TEERegistry interface defines methods required for TEE verification
type TEERegistry interface {
	IsRegionAllowed(regionID string) bool
	VerifyMeasurement(enclaveID, measurement []byte, regionID string) bool
	IsTEERegistered(enclaveID []byte) bool
	CheckRegionalPolicy(regionID, policyName string) (interface{}, bool)
	IsDCAPSupported() bool
}

// Helper functions to create test attestations

func setupMockTEERegistry() *MockTEERegistry {
	mockRegistry := &MockTEERegistry{
		allowedRegions:            []string{"us-west", "us-east", "eu-central"},
		regionMeasurements:        make(map[string][]byte),
		teeIDs:                    make(map[string][]byte),
		regionalPolicies:          make(map[string]map[string]interface{}),
		dcapSupported:             true,
		accumulatorTEEs:           make(map[string][]byte),
		usedAttestations:          make(map[string]bool),
		securityHeuristicsEnabled: true,
		vulnerableMeasurements:    make(map[string]string),
	}

	// Set up default test TEE IDs
	mockRegistry.RegisterTEE([]byte("tee-1"), []byte("default-measurement"))
	mockRegistry.RegisterTEE([]byte("tee-2"), []byte("default-measurement"))

	// Set up regional measurements
	usWestMeasurement := make([]byte, 32)
	_, _ = rand.Read(usWestMeasurement)
	mockRegistry.AddRegionMeasurement("us-west", usWestMeasurement)

	// Set up default region policies
	policies := make(map[string]map[string]interface{})
	policies["us-west"] = map[string]interface{}{
		"requiredSignatures": 1,
		"maxLatency":         2000, // 2 seconds
		"crossRegionVerify":  false,
	}
	mockRegistry.regionalPolicies = policies

	return mockRegistry
}

func setupMultiRegionRegistry() *MockTEERegistry {
	registry := setupMockTEERegistry()

	// Add region-specific measurements
	usEastMeasurement := make([]byte, 32)
	euCentralMeasurement := make([]byte, 32)
	_, _ = rand.Read(usEastMeasurement)
	_, _ = rand.Read(euCentralMeasurement)

	registry.AddRegionMeasurement("us-east", usEastMeasurement)
	registry.AddRegionMeasurement("eu-central", euCentralMeasurement)

	return registry
}

func createTestSGXAttestation() *Attestation {
	// Generate a random TxID
	txID, _ := ids.FromString("f1d5e0a7b9c8d7e6f5a4b3c2d1e0f1a2b3c4d5e6f7a8b9c8d7e6f5a4b3c2d1e0")

	// Generate random bytes for EnclaveID, Measurement, Signature, and Data
	enclaveID := make([]byte, 32)
	measurement := make([]byte, 32)
	signature := make([]byte, 64)
	data := make([]byte, 32)

	_, _ = rand.Read(enclaveID)
	_, _ = rand.Read(measurement)
	_, _ = rand.Read(signature)
	_, _ = rand.Read(data)

	return &Attestation{
		TxID:        txID,
		Type:        SGXAttestation,
		EnclaveID:   enclaveID,
		RegionID:    "us-east",
		Measurement: measurement,
		Signature:   signature,
		Timestamp:   time.Now(),
		Data:        data,
	}
}

func createTestSEVAttestation() *Attestation {
	attestation := createTestSGXAttestation()
	attestation.Type = SEVAttestation
	return attestation
}

func createTestDualAttestation() *Attestation {
	attestation := createTestSGXAttestation()
	attestation.Type = DualAttestation

	// Generate a random cross-signature
	crossSignature := make([]byte, 64)
	_, _ = rand.Read(crossSignature)
	attestation.CrossSignature = crossSignature

	return attestation
}

func createTestDCAPAttestation() *Attestation {
	attestation := createTestSGXAttestation()

	// Add DCAP-specific fields that would be in a real implementation
	// This is just a placeholder since the real structure would depend on your actual DCAP implementation
	attestation.Data = append(attestation.Data, []byte("DCAP")...)

	return attestation
}

func createTestAttestationWithAccumulator() *Attestation {
	attestation := createTestSGXAttestation()

	// Extract ID as bytes
	txIDBytes := attestation.TxID[:]

	// Generate hash from txID for accumulator calculation
	hash := sha256.Sum256(txIDBytes)

	// Create a valid accumulator value
	currentAccumulator := updateAccumulator(hash[:])

	// Use the same hash but different calculation for previous accumulator
	prevAccumulatorHash := sha256.Sum256(append(hash[:], []byte("prev")...))
	prevAccumulator := prevAccumulatorHash[:]

	// Generate a valid witness
	witness := computeWitness(prevAccumulator)

	// Generate a sample state change
	changedKeys := []string{"key1", "key2", "key3"}
	changedValues := [][]byte{
		[]byte("value1"),
		[]byte("value2"),
		[]byte("value3"),
	}

	// Create a valid state proof that will pass verification
	stateProof := &StateTransitionProof{
		Type:                AccumulatorProof,
		AccumulatorValue:    currentAccumulator, // This will match what's expected in the verifier
		PreviousAccumulator: prevAccumulator,
		Witness:             witness,
		ChangedKeys:         changedKeys,
		ChangedValues:       changedValues,
		TxHash:              txIDBytes,
	}

	// Create accumulator witness
	accumulatorWitness := &AccumulatorWitness{
		Value:           witness,
		LastAccumulator: prevAccumulator,
		Executor:        "executor-1",
		Measurement:     attestation.Measurement,
		EnclaveType:     "SGX",
		Timestamp:       uint64(time.Now().Unix()),
	}

	attestation.StateProof = stateProof
	attestation.Accumulator = accumulatorWitness

	return attestation
}

func tamperAccumulatorProof(attestation *Attestation) *Attestation {
	tampered := &Attestation{}
	*tampered = *attestation

	// Create a deep copy of the state proof
	tampered.StateProof = &StateTransitionProof{}
	*tampered.StateProof = *attestation.StateProof

	// Tamper with the accumulator value
	tamperedAccumulator := make([]byte, len(tampered.StateProof.AccumulatorValue))
	copy(tamperedAccumulator, tampered.StateProof.AccumulatorValue)
	tamperedAccumulator[0] ^= 0xFF // Flip some bits
	tampered.StateProof.AccumulatorValue = tamperedAccumulator

	return tampered
}

