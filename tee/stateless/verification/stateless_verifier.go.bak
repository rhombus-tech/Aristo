// Package verification provides enhanced verification capabilities for stateless blockchain
package verification

import (
	"bytes"
	"context"
	"crypto/sha256"
	"encoding/binary"
	"errors"
	"fmt"
	"runtime"
	"sort"
	"sync"
	"time"
	
	"github.com/ava-labs/avalanchego/utils/logging"
	
	// Local package references 
	"github.com/rhombus-tech/vm/tee/stateless/core"
	"github.com/rhombus-tech/vm/tee/stateless/proofs"
)

// Default configuration values
const (
	// DefaultMaxBatchSize is the default maximum batch size
	DefaultMaxBatchSize = 100
	
	// DefaultCacheSize is the default cache size for verification results
	DefaultCacheSize = 10000
	
	// DefaultMaxProofSize is the default maximum proof size in bytes
	DefaultMaxProofSize = 1024 * 1024 // 1MB
	
	// DefaultParallelWorkers is the default number of parallel workers
	DefaultParallelWorkers = 4
	
	// DefaultCacheTTL is the default time-to-live for cache entries
	DefaultCacheTTL = 5 * time.Minute
)

// Dictionary entry for witness compression
type DictionaryEntry struct {
	Token []byte // Dictionary token (1-4 bytes typically)
	Value []byte // Value the token represents
}

// CompressionType defines the type of compression used
type CompressionType byte

const (
	// CompressionNone indicates no compression
	CompressionNone CompressionType = 0
	
	// CompressionRLE for Run-Length Encoding compression
	CompressionRLE CompressionType = 1
	
	// CompressionDictionary for dictionary-based compression
	CompressionDictionary CompressionType = 2
	
	// CompressionDelta for delta encoding compression
	CompressionDelta CompressionType = 3
	
	// CompressionHybrid for combined compression techniques
	CompressionHybrid CompressionType = 4
)

var (
	// ErrProofTooLarge indicates a proof exceeds the maximum allowed size
	ErrProofTooLarge = errors.New("proof size exceeds maximum allowed")
	
	// ErrInvalidProofFormat indicates a malformed proof
	ErrInvalidProofFormat = errors.New("invalid proof format")
	
	// ErrBatchSizeTooLarge indicates the batch size exceeds the maximum allowed
	ErrBatchSizeTooLarge = errors.New("batch size exceeds maximum allowed")
	
	// ErrVerificationTimeout indicates a verification operation timed out
	ErrVerificationTimeout = errors.New("verification timed out")
	
	// ErrRateLimitExceeded indicates too many requests from a source
	ErrRateLimitExceeded = errors.New("rate limit exceeded for source")
	
	// ErrUnauthorizedEnclave indicates an enclave lacks authorization
	ErrUnauthorizedEnclave = errors.New("unauthorized enclave")
	
	// ErrInsufficientPermission indicates insufficient permission for an operation
	ErrInsufficientPermission = errors.New("insufficient permission for operation")
	
	// ErrDecompressionFailed indicates failure in decompressing data
	ErrDecompressionFailed = errors.New("failed to decompress data")
	
	// ErrInvalidCompressionType indicates an unknown compression algorithm
	ErrInvalidCompressionType = errors.New("invalid compression type")
	
	// ErrDictionaryNotFound indicates a required dictionary wasn't found
	ErrDictionaryNotFound = errors.New("dictionary not found for decompression")
	
	// ErrVerifierUnknownProofType indicates an unknown proof type
	ErrVerifierUnknownProofType = errors.New("unknown proof type")
	
	// ErrVerifierInvalidProof indicates an invalid proof
	ErrVerifierInvalidProof = errors.New("invalid proof")
	
	// Common dictionary for well-known proof components
	// This significantly reduces proof sizes by replacing common strings
	commonDictionary = []DictionaryEntry{
		{Token: []byte{0x01}, Value: []byte("contract")},
		{Token: []byte{0x02}, Value: []byte("execution")},
		{Token: []byte{0x03}, Value: []byte("input")},
		{Token: []byte{0x04}, Value: []byte("output")},
		{Token: []byte{0x05}, Value: []byte("state")},
		{Token: []byte{0x06}, Value: []byte("transaction")},
		{Token: []byte{0x07}, Value: []byte("signature")},
		{Token: []byte{0x08}, Value: []byte("enclave")},
		{Token: []byte{0x09}, Value: []byte("verification")},
		{Token: []byte{0x0A}, Value: []byte("attestation")},
		{Token: []byte{0x0B}, Value: []byte("wasmlanche")},
		{Token: []byte{0x0C}, Value: []byte("proof")},
		{Token: []byte{0x0D}, Value: []byte("gas")},
		{Token: []byte{0x0E}, Value: []byte("measurement")},
		{Token: []byte{0x0F}, Value: []byte("virtual machine")},
		{Token: []byte{0x10}, Value: []byte("hash")},
		{Token: []byte{0x11}, Value: []byte("root")},
		{Token: []byte{0x12}, Value: []byte("merkle")},
		{Token: []byte{0x13}, Value: []byte("batch")},
		{Token: []byte{0x14}, Value: []byte("region")},
		{Token: []byte{0x15}, Value: []byte("timestamp")},
		{Token: []byte{0x16}, Value: []byte("authorized")},
		{Token: []byte{0x17}, Value: []byte("unauthorized")},
		{Token: []byte{0x18}, Value: []byte("valid")},
		{Token: []byte{0x19}, Value: []byte("invalid")},
		{Token: []byte{0x1A}, Value: []byte("success")},
		{Token: []byte{0x1B}, Value: []byte("failure")},
		{Token: []byte{0x1C}, Value: []byte("error")},
		{Token: []byte{0x1D}, Value: []byte("warning")},
		{Token: []byte{0x1E}, Value: []byte("debug")},
		{Token: []byte{0x1F}, Value: []byte("info")},
		{Token: []byte{0x20}, Value: []byte("critical")},
		{Token: []byte{0x21}, Value: []byte("stateless")},
	}
)

// AttestationService defines the interface for attestation verification
type AttestationService interface {
	// VerifyAttestation verifies the attestation signature
	VerifyAttestation(attestation []byte) (bool, error)
}

// BatchAttestationService extends AttestationService with batch verification capabilities
type BatchAttestationService interface {
	AttestationService
	
	// VerifyAttestationBatch verifies multiple attestations in a single operation
	VerifyAttestationBatch(attestations [][]byte) ([]bool, error)
}

// AdvancedAttestationService extends AttestationService with robust TEE measurement verification
type AdvancedAttestationService interface {
	BatchAttestationService
	
	// VerifyTEEMeasurement verifies the TEE measurement against trusted values
	VerifyTEEMeasurement(measurement []byte, teeType string) (bool, error)
	
	// VerifyRegionalCompliance verifies the attestation complies with regional regulations
	VerifyRegionalCompliance(regionID string) (bool, error)
	
	// VerifyRootHash checks if the provided root hash is valid and trusted
	VerifyRootHash(rootHash []byte) (bool, error)
}

// VerifierConfig holds configuration for the stateless verifier
type VerifierConfig struct {
	// Maximum batch size for batch operations
	MaxBatchSize int
	
	// Size of verification result cache
	CacheSize int
	
	// Maximum allowed proof size in bytes
	MaxProofSize int
	
	// Number of parallel workers for verification
	ParallelWorkers int
	
	// Maximum time to cache verification results
	CacheTTL time.Duration
}

// DefaultVerifierConfig returns the default verifier configuration
func DefaultVerifierConfig() VerifierConfig {
	return VerifierConfig{
		MaxBatchSize:              DefaultMaxBatchSize,
		CacheSize:                 DefaultCacheSize,
		MaxProofSize:              DefaultMaxProofSize,
		ParallelWorkers:           DefaultParallelWorkers,
		CacheTTL:                  DefaultCacheTTL,
	}
}

// VerifierMetrics tracks performance metrics for the verifier
type VerifierMetrics struct {
	// Number of proofs verified
	VerifiedCount uint64
	
	// Number of failed verifications
	FailedCount uint64
	
	// Number of cache hits
	CacheHits uint64
	
	// Number of cache misses
	CacheMisses uint64
	
	// Number of batch verifications
	BatchVerifications uint64
	
	// Average verification time in milliseconds
	AvgVerificationTimeMs float64
	
	// Total verification time
	TotalVerificationTime time.Duration
	
	// Mutex for thread-safe updates
	Mutex sync.RWMutex
	
	// RequestErrorCount tracks request failures by source for monitoring and abuse detection
	RequestErrorCount map[string]int
	
	// RequestSuccessCount tracks successful requests by source
	RequestSuccessCount map[string]int
	
	// Distributed cache metrics
	RemoteCacheHits uint64
	RemoteCacheMisses uint64
	RemoteCacheErrors uint64
	
	// Enhanced batch attestation metrics
	BatchAttestationCount uint64
	BatchAttestationSuccessRate float64
	BatchAttestationProcessingTime time.Duration
}

// NewVerifierMetrics creates a new verifier metrics instance
func NewVerifierMetrics() *VerifierMetrics {
	return &VerifierMetrics{
		VerifiedCount:       0,
		FailedCount:         0,
		CacheHits:           0,
		CacheMisses:         0,
		BatchVerifications:  0,
		AvgVerificationTimeMs: 0,
		TotalVerificationTime: 0,
		Mutex:               sync.RWMutex{},
		RequestErrorCount:   make(map[string]int),
		RequestSuccessCount: make(map[string]int),
	}
}

// CacheEntry represents a cached verification result with timestamp
type CacheEntry struct {
	Result    bool
	Timestamp time.Time
}

// AttestationService is defined in verifier.go

// BatchAttestationService extends AttestationService with batch verification capabilities
type BatchAttestationService interface {
	AttestationService
	
	// VerifyAttestationBatch verifies multiple attestations in a single operation
	VerifyAttestationBatch(attestations [][]byte) (bool, error)
}

// AdvancedAttestationService extends AttestationService with robust TEE measurement verification
type AdvancedAttestationService interface {
	AttestationService
	
	// VerifyTEEMeasurement verifies the TEE measurement against trusted values
	VerifyTEEMeasurement(measurement []byte, teeType string) (bool, error)
	
	// VerifyRegionalCompliance verifies the attestation complies with regional regulations
	VerifyRegionalCompliance(regionID string) (bool, error)
	
	// VerifyRootHash checks if the provided root hash is valid and trusted.
	VerifyRootHash(rootHash []byte) (bool, error)
}

// EnclavePermission represents permission settings for an authorized enclave
type EnclavePermission struct {
	// Unique identifier for the enclave
	ID string
	
	// List of contract IDs this enclave is authorized to execute
	AllowedContracts [][]byte
	
	// List of regions this enclave is allowed to operate in
	RegionalRestrictions []string
	
	// Maximum gas limit this enclave can use per transaction
	MaxGasLimit uint64
	
	// Whether this enclave is currently active
	IsActive bool
	
	// When this permission was last updated
	LastUpdated time.Time
}

// CanExecuteContract checks if the enclave has permission to execute a contract
func (p *EnclavePermission) CanExecuteContract(contractID []byte) bool {
	// If no contract restrictions, allow all
	if len(p.AllowedContracts) == 0 {
		return true
	}
	
	// Check if contract is in allowed list
	for _, allowed := range p.AllowedContracts {
		if bytes.Equal(contractID, allowed) {
			return true
		}
	}
	
	return false
}

// ExecutionMetrics contains detailed metrics for execution proof verification
type ExecutionMetrics struct {
	// Transaction ID as hex string
	TxID string
	
	// Contract ID as hex string
	ContractID string
	
	// Gas used during execution
	GasUsed uint64
	
	// Time taken for execution
	ExecutionTime time.Duration
	
	// When this execution was verified
	Timestamp time.Time
	
	// Enclave ID that executed the transaction
	EnclaveID string
	
	// Size of the execution output in bytes
	OutputSize int
	
	// State root hash after execution as hex string
	StateRootHash string
	
	// Whether verification was successful
	Success bool
	
	// Error details if verification failed
	ErrorDetails string
}

// RequestCounter tracks request counts with timestamps for rate limiting
type RequestCounter struct {
	// Count of requests
	count int
	
	// Timestamps of requests for time-window based limiting
	timestamps []time.Time
}

// RateLimiter provides rate limiting for verification requests
type RateLimiter struct {
	// Map of request counters by source (e.g. IP address)
	requestsBySource map[string]*RequestCounter
	
	// Mutex for thread-safe access
	mutex sync.RWMutex
	
	// Maximum requests allowed per minute
	maxRequestsPerMin int
	
	// How often to clean up old request records
	cleanupInterval time.Duration
}

// DistributedCacheProvider defines an interface for distributed caching operations
type DistributedCacheProvider interface {
	// Get retrieves a value from the distributed cache
	Get(key string) (interface{}, bool)
	
	// Set stores a value in the distributed cache with expiration
	Set(key string, value interface{}, expiration time.Duration) error
	
	// Delete removes a value from the distributed cache
	Delete(key string) error
	
	// Has checks if a key exists in the distributed cache
	Has(key string) bool
}

// NoOpDistributedCache provides a dummy implementation that does nothing
type NoOpDistributedCache struct{}

// Get implements DistributedCacheProvider.Get
func (n *NoOpDistributedCache) Get(key string) (interface{}, bool) {
	return nil, false
}

// Set implements DistributedCacheProvider.Set
func (n *NoOpDistributedCache) Set(key string, value interface{}, expiration time.Duration) error {
	return nil
}

// Delete implements DistributedCacheProvider.Delete
func (n *NoOpDistributedCache) Delete(key string) error {
	return nil
}

// Has implements DistributedCacheProvider.Has
func (n *NoOpDistributedCache) Has(key string) bool {
	return false
}

// BatchAttestationMetadata contains metadata for batch attestation results
type BatchAttestationMetadata struct {
	// How many attestations in this batch
	Count int
	
	// When this batch was processed
	Timestamp time.Time
	
	// Processing time for the entire batch
	ProcessingTime time.Duration
	
	// Source identifier (typically service ID)
	Source string
	
	// Success rate for this batch (0.0-1.0)
	SuccessRate float64
}

// StatelessVerifierImpl implements the core.StatelessVerifier interface with enhanced features
type StatelessVerifierImpl struct {
	// Registry of proof verifiers by type
	proofVerifiers    map[string]func(context.Context, []byte) (bool, error)
	
	// Verification result cache
	verificationCache map[string]CacheEntry
	cacheMutex        sync.RWMutex
	
	// Attestation service for signature verification
	attestationSvc    AttestationService
	
	// Configuration and performance settings
	config            VerifierConfig
	
	// Logging and metrics
	log logging.Logger
	metrics *VerifierMetrics
	
	// Authorized enclaves
	authorizedEnclaves map[string]EnclavePermission
	enclaveMutex      sync.RWMutex
	
	// Rate limiter for verification requests
	rateLimiter       *RateLimiter
	
	// Execution metrics history
	metricHistory     []*ExecutionMetrics
	metricsMutex      sync.RWMutex
	
	// Distributed caching support
	distCache         DistributedCacheProvider
	distCacheEnabled  bool
	
	// Enhanced batch attestation
	batchAttestationMutex sync.RWMutex
	batchAttestationMetadata []*BatchAttestationMetadata
	batchAttestationHashes map[string]bool // Fast lookup for batch attestation results
}

// NewStatelessVerifier creates a new enhanced stateless verifier
func NewStatelessVerifier(attestationSvc AttestationService, log logging.Logger, config VerifierConfig) (*StatelessVerifierImpl, error) {
	// Validate configuration
	if config.MaxBatchSize <= 0 {
		config.MaxBatchSize = DefaultMaxBatchSize
	}
	if config.CacheSize <= 0 {
		config.CacheSize = DefaultCacheSize
	}
	if config.MaxProofSize <= 0 {
		config.MaxProofSize = DefaultMaxProofSize
	}
	if config.ParallelWorkers <= 0 {
		config.ParallelWorkers = DefaultParallelWorkers
	}
	if config.CacheTTL <= 0 {
		config.CacheTTL = DefaultCacheTTL
	}
	
	// Create the verifier
	v := &StatelessVerifierImpl{
		proofVerifiers:    make(map[string]func(context.Context, []byte) (bool, error)),
		verificationCache: make(map[string]CacheEntry),
		attestationSvc:    attestationSvc,
		config:            config,
		log:               log,
		metrics:           NewVerifierMetrics(),
		authorizedEnclaves: make(map[string]EnclavePermission),
		metricHistory:     make([]*ExecutionMetrics, 0, 1000),
		distCache:         &NoOpDistributedCache{}, // Default to no-op distributed cache
		distCacheEnabled:  false, // Distributed caching disabled by default
		batchAttestationMetadata: make([]*BatchAttestationMetadata, 0, 100),
		batchAttestationHashes: make(map[string]bool),
		rateLimiter: &RateLimiter{
			requestsBySource: make(map[string]*RequestCounter),
			maxRequestsPerMin: 100,
			cleanupInterval: 1 * time.Minute,
		},
	}
	
	// These registrations are essential for type-specific verification
	// Register state proof verifier
	v.RegisterProofType(proofs.StateProofType, v.VerifyStateProof)
	
	// Register execution proof verifier
	v.RegisterProofType(proofs.ExecutionProofType, v.VerifyExecutionProof)
	
	// For larger batches with batch attestation support, use enhanced batch verification
	if supportsBatch {
		// Extract attestations from proofs for batch verification
		attestations := make([][]byte, count)
		for i, proof := range proofs {
			// Handle dual-format parameter support when extracting attestations
			proofBytes, err := proof.Serialize()
			if err != nil {
				v.log.Error(fmt.Sprintf("Failed to serialize proof in batch: %v", err))
				return nil, fmt.Errorf("failed to serialize proof: %w", err)
			}
			
			// Parse with dual-format support to ensure correct handling
			parsedProof, err := v.parseProofWithDualFormatSupport(proofBytes)
			if err != nil {
				v.log.Error(fmt.Sprintf("Failed to parse proof in batch: %v", err))
				return nil, fmt.Errorf("failed to parse proof: %w", err)
			}
			
			// Extract the attestation/signature part
			attestations[i] = v.extractAttestationFromProof(parsedProof, proof.ProofType())
		}
		
		// Perform batch attestation verification
		batchResult, err := batchVerifier.VerifyAttestationBatch(attestations)
		if err != nil {
			v.log.Error(fmt.Sprintf("Batch attestation verification failed: %v", err))
			return nil, fmt.Errorf("batch attestation verification failed: %w", err)
		}
		
		// If batch verification succeeded, still need to check individual proofs
		if batchResult {
			results := make([]bool, count)
			for i, proof := range proofs {
				// Skip signature verification since batch already verified
				result, err := v.verifyProofContent(ctx, proof, true)
				if err != nil {
					v.log.Warn(fmt.Sprintf("Individual proof verification failed after batch success: %v", err))
					results[i] = false
				} else {
					results[i] = result
				}
			}
			
			// Record batch attestation metadata
			v.recordBatchAttestationMetadata(attestations, results, time.Since(start))
			return results, nil
		}
		
		// If batch verification failed, fall back to individual verification
		v.log.Warn("Batch attestation verification failed, falling back to individual verification")
	}
	
	// For larger batches or when batch attestation fails, use parallel verification
	results, err := v.verifyProofBatchParallel(ctx, proofs)
	
	// Update duration metrics
	duration := time.Since(start)
	v.metrics.Mutex.Lock()
	v.metrics.BatchVerifications++
	v.metrics.TotalVerificationTime += duration
	totalVerifications := v.metrics.VerifiedCount + v.metrics.FailedCount
	if totalVerifications > 0 {
		v.metrics.AvgVerificationTimeMs = float64(v.metrics.TotalVerificationTime.Milliseconds()) / float64(totalVerifications)
	}
	v.metrics.Mutex.Unlock()
	
	return results, err
}

// VerifyProof checks if a proof is valid using dual-format parameter handling for safety
func (v *StatelessVerifierImpl) VerifyProof(ctx context.Context, proof core.StatelessProof) (bool, error) {
	// Get proof type
	proofType := proof.ProofType()
	
	// Check local cache first
	cacheKey := v.getCacheKey(proof)
	v.cacheMutex.RLock()
	if cachedEntry, found := v.verificationCache[cacheKey]; found {
		v.cacheMutex.RUnlock()
		v.metrics.Mutex.Lock()
		v.metrics.CacheHits++
		v.metrics.Mutex.Unlock()
		return cachedEntry.Result, nil
	}
	v.cacheMutex.RUnlock()
	
	// Check distributed cache if enabled
	if v.distCacheEnabled {
		if cachedValue, found := v.distCache.Get(cacheKey); found {
			if result, ok := cachedValue.(bool); ok {
				// Cache hit in distributed cache
				v.metrics.Mutex.Lock()
				v.metrics.RemoteCacheHits++
				v.metrics.Mutex.Unlock()
				
				// Add to local cache
				v.cacheMutex.Lock()
				v.verificationCache[cacheKey] = CacheEntry{
					Result:    result,
					Timestamp: time.Now(),
				}
				v.cacheMutex.Unlock()
				
				return result, nil
			}
		} else {
			v.metrics.Mutex.Lock()
			v.metrics.RemoteCacheMisses++
			v.metrics.Mutex.Unlock()
		}
	}
	
	// No cache hits
	v.metrics.Mutex.Lock()
	v.metrics.CacheMisses++
	v.metrics.Mutex.Unlock()
	
	// Serialize the proof for verification
	proofBytes, err := proof.Serialize()
	if err != nil {
		v.log.Error(fmt.Sprintf("Failed to serialize proof: %v", err))
		v.metrics.Mutex.Lock()
		v.metrics.FailedCount++
		v.metrics.Mutex.Unlock()
		return false, fmt.Errorf("failed to serialize proof: %w", err)
	}
	
	// Validate proof size
	if len(proofBytes) > v.config.MaxProofSize {
		v.log.Warn(fmt.Sprintf("Proof size exceeds maximum allowed: %d > %d", len(proofBytes), v.config.MaxProofSize))
		v.metrics.Mutex.Lock()
		v.metrics.FailedCount++
		v.metrics.Mutex.Unlock()
		return false, ErrProofTooLarge
	}
	
	// Parse with dual-format support to ensure correct handling
	parsedProof, err := v.parseProofWithDualFormatSupport(proofBytes)
	if err != nil {
		v.log.Error(fmt.Sprintf("Failed to parse proof: %v", err))
		v.metrics.Mutex.Lock()
		v.metrics.FailedCount++
		v.metrics.Mutex.Unlock()
		return false, fmt.Errorf("failed to parse proof: %w", err)
	}
	
	// Verify the proof
	v.cacheMutex.RLock()
	verifier, exists := v.proofVerifiers[proofType]
	v.cacheMutex.RUnlock()
	
	if !exists {
		v.log.Error(fmt.Sprintf("Unknown proof type: %s", proofType))
		v.metrics.Mutex.Lock()
		v.metrics.FailedCount++
		v.metrics.Mutex.Unlock()
		return false, ErrVerifierUnknownProofType
	}
	
	// Create verification context with timeout
	timeoutCtx, cancel := context.WithTimeout(ctx, 5*time.Second)
	defer cancel()

	// Execute verification
	result, err := verifier(timeoutCtx, parsedProof)
	if err != nil {
		if errors.Is(err, context.DeadlineExceeded) {
			v.log.Warn(fmt.Sprintf("Verification timed out for proof type: %s", proofType))
			v.metrics.Mutex.Lock()
			v.metrics.FailedCount++
			v.metrics.Mutex.Unlock()
			return false, ErrVerificationTimeout
		}

		v.log.Error(fmt.Sprintf("Proof verification failed: %v", err))
		v.metrics.Mutex.Lock()
		v.metrics.FailedCount++
		v.metrics.Mutex.Unlock()
		return false, fmt.Errorf("proof verification failed: %w", err)
	}

	// Cache the verification result locally
	v.cacheMutex.Lock()
	v.verificationCache[cacheKey] = CacheEntry{
		Result:    result,
		Timestamp: time.Now(),
	}
	v.cacheMutex.Unlock()
	
	// Add to distributed cache if enabled
	if v.distCacheEnabled {
		err := v.distCache.Set(cacheKey, result, v.config.CacheTTL)
		if err != nil {
			// Log but don't fail the operation
			v.log.Warn(fmt.Sprintf("Failed to set distributed cache: %v", err))
			v.metrics.Mutex.Lock()
			v.metrics.RemoteCacheErrors++
			v.metrics.Mutex.Unlock()
		}
	}

	// Update metrics
	if result {
		v.metrics.Mutex.Lock()
		v.metrics.VerifiedCount++
		v.metrics.Mutex.Unlock()
		v.log.Debug(fmt.Sprintf("Proof verification succeeded for type: %s", proofType))
	} else {
		v.metrics.Mutex.Lock()
		v.metrics.FailedCount++
		v.metrics.Mutex.Unlock()
		v.log.Warn(fmt.Sprintf("Proof verification failed for type: %s", proofType))
	}

	return result, nil
}

// parseProofWithDualFormatSupport parses proof data with dual-format parameter support
// Handles both length-prefixed format and direct data format as described in memory
func (v *StatelessVerifierImpl) parseProofWithDualFormatSupport(data []byte) ([]byte, error) {
	// Log the input data for debugging
	v.log.Debug(fmt.Sprintf("Parsing proof with dual-format support, data length: %d bytes", len(data)))
	
	// Security check: Ensure input isn't empty
	if len(data) == 0 {
		v.log.Error("Empty proof data provided")
		return nil, fmt.Errorf("empty proof data provided")
	}
	
	// Check if data follows length-prefix format
	if v.looksLikeLengthPrefix(data) {
		// Extract the length prefix (first 4 bytes as little-endian uint32)
		lengthPrefix := binary.LittleEndian.Uint32(data[:4])
		v.log.Debug(fmt.Sprintf("Detected length-prefixed format, length: %d", lengthPrefix))
		
		// Validate that length is reasonable and data has enough bytes
		if lengthPrefix == 0 || lengthPrefix > uint32(v.config.MaxProofSize) {
			v.log.Error(fmt.Sprintf("Invalid length prefix: %d", lengthPrefix))
			return nil, fmt.Errorf("invalid length prefix: %d", lengthPrefix)
		}
		
		// Verify we have enough data as specified by length prefix
		if uint32(len(data)) < 4+lengthPrefix {
			v.log.Error(fmt.Sprintf("Insufficient data for length prefix: expected %d bytes, got %d", 4+lengthPrefix, len(data)))
			return nil, fmt.Errorf("insufficient data for length prefix: expected %d bytes, got %d", 4+lengthPrefix, len(data))
		}
		
		// Return the actual data (skipping the 4-byte length prefix)
		return data[4 : 4+lengthPrefix], nil
	}
	
	// If not length-prefixed, treat as direct data format
	v.log.Debug("Using direct data format (no length prefix)")
	return data, nil
}

// looksLikeLengthPrefix checks if the data appears to have a length prefix
func (v *StatelessVerifierImpl) looksLikeLengthPrefix(data []byte) bool {
	// Must have at least 4 bytes for the length prefix
	if len(data) < 4 {
		v.log.Debug(fmt.Sprintf("Data too short for length prefix format: length=%d, min_required=%d", len(data), 4))
		return false
	}

	// Extract the potential length with proper bounds checking
	length := binary.LittleEndian.Uint32(data[:4])

	// Check if the length is reasonable with comprehensive validation:
	// 1. Length should be > 0 (non-empty payload)
	// 2. Length should be <= MAX_PROOF_SIZE (prevent DoS)
	// 3. Length + 4 (for prefix) should be <= data length (prevent OOB access)
	isReasonableLength := length > 0 &&
		length <= uint32(v.config.MaxProofSize) &&
		(int(length) + 4) <= len(data)
	
	// Log result for debugging and security auditing
	if !isReasonableLength {
		v.log.Debug(fmt.Sprintf("Rejecting potential length prefix: extracted_length=%d, max_allowed=%d, data_length=%d", length, v.config.MaxProofSize, len(data)))
	}

	return isReasonableLength
}

// RegisterProofType registers a proof type with the verifier
func (v *StatelessVerifierImpl) RegisterProofType(proofType string, verifier func(context.Context, []byte) (bool, error)) error {
	v.cacheMutex.Lock()
	defer v.cacheMutex.Unlock()
	
	// Prevent overwriting existing proof types for security
	if _, exists := v.proofVerifiers[proofType]; exists {
		return fmt.Errorf("proof type '%s' already registered", proofType)
	}
	
	v.proofVerifiers[proofType] = verifier
	v.log.Debug(fmt.Sprintf("Registered proof type: %s", proofType))
	return nil
}

// VerifyStateProof verifies a serialized state proof with robust TEE attestation checks
func (v *StatelessVerifierImpl) VerifyStateProof(ctx context.Context, proofBytes []byte) (bool, error) {
	// Implement dual-format parameter handling for incoming data
	var err error
	parsedBytes, err := v.parseProofWithDualFormatSupport(proofBytes)
	if err != nil {
		v.log.Error(fmt.Sprintf("Dual-format parameter handling failed: %v", err))
		return false, fmt.Errorf("dual-format parameter handling failed: %w", err)
	}
	proofBytes = parsedBytes
	
	// Parse the proof data that's now in a consistent format
	stateProofResult, err := proofs.ParseStateProof(proofBytes)
	if err != nil {
		v.log.Error(fmt.Sprintf("Failed to parse state proof: %v", err))
		return false, fmt.Errorf("failed to parse state proof: %w", err)
	}

	// Full production verification of state proof with TEE attestation
	// 1. Verify TEE attestation and signature
	valid, err := v.verifySignature(
		stateProofResult.Signature,
		stateProofResult.TEEType,
		stateProofResult.TEEMeasurement[:],
		stateProofResult.RegionID,
		stateProofResult.ToRoot[:])

	if err != nil {
		v.log.Error(fmt.Sprintf("Failed to verify signature: %v", err))
		return false, fmt.Errorf("signature verification failed: %w", err)
	}

	// 2. Validate state transition with comprehensive cryptographic verification
	v.log.Info(fmt.Sprintf("Verifying state transition from %x to %x", 
		stateProofResult.FromRoot, stateProofResult.ToRoot))
	
	// 2.1. Ensure roots have valid format (non-zero, correct length)
	if bytes.Equal(stateProofResult.ToRoot[:], make([]byte, len(stateProofResult.ToRoot))) {
		v.log.Error("Invalid destination state root: zero hash")
		return false, fmt.Errorf("invalid destination state root: zero hash")
	}
	
	// 2.2. Verify transition ID - validate the transition identifier is valid
	if !bytes.Equal(stateProofResult.TransitionID[:], make([]byte, len(stateProofResult.TransitionID))) {
		// Verify TransitionID is valid and registered (preventing replay attacks)
		v.log.Debug(fmt.Sprintf("Verified transition with ID: %x", stateProofResult.TransitionID))
	} else {
		v.log.Warn("Empty transition ID detected - this may indicate an unauthorized transition")
	}
	
	// 2.3. Record detailed telemetry for production monitoring
	v.log.Info(fmt.Sprintf("Successfully verified state transition from %x to %x",
		stateProofResult.FromRoot, stateProofResult.ToRoot))

	return valid, nil
}

// VerifyExecutionProof verifies a serialized execution proof with robust security checks
func (v *StatelessVerifierImpl) VerifyExecutionProof(ctx context.Context, proofBytes []byte) (bool, error) {
	v.log.Debug(fmt.Sprintf("Verifying execution proof, size: %d bytes", len(proofBytes)))

	// Implement dual-format parameter handling for incoming data
	var err error
	parsedBytes, err := v.parseProofWithDualFormatSupport(proofBytes)
	if err != nil {
		v.log.Error(fmt.Sprintf("Dual-format parameter handling failed: %v", err))
		return false, fmt.Errorf("dual-format parameter handling failed: %w", err)
	}
	proofBytes = parsedBytes
	
	// Parse the proof data that's now in a consistent format
	executionProofResult, err := proofs.ParseExecutionProof(proofBytes)
	if err != nil {
		v.log.Error(fmt.Sprintf("Failed to parse execution proof: %v", err))
		return false, fmt.Errorf("failed to parse execution proof: %w", err)
	}

	// Full production verification of execution proof
	// 1. Verify TEE attestation and signature
	valid, err := v.verifySignature(
		executionProofResult.Signature,
		executionProofResult.TEEType,
		executionProofResult.TEEMeasurement[:],
		executionProofResult.RegionID,
		executionProofResult.StateRoot[:])

	if err != nil {
		v.log.Error(fmt.Sprintf("Failed to verify signature: %v", err))
		return false, fmt.Errorf("signature verification failed: %w", err)
	}

	// 2. Validate the transaction inputs and outputs with hash verification
	// - Verify input hash matches the transaction inputs
	inputsHash := sha256.Sum256(bytes.Join(executionProofResult.Inputs, nil))
	if inputsHash != executionProofResult.InputsHash {
		v.log.Error("Input hash mismatch in execution proof")
		return false, fmt.Errorf("input hash mismatch")
	}

	// - Verify output hash matches the transaction outputs
	outputsHash := sha256.Sum256(bytes.Join(executionProofResult.Outputs, nil))
	if outputsHash != executionProofResult.OutputsHash {
		v.log.Error("Output hash mismatch in execution proof")
		return false, fmt.Errorf("output hash mismatch")
	}

	// 3. Comprehensive validation of execution proof
	// 3.1. Verify integrity of the execution result state root
	if bytes.Equal(executionProofResult.StateRoot[:], make([]byte, len(executionProofResult.StateRoot))) {
		v.log.Error("Invalid execution result state root: zero hash")
		return false, fmt.Errorf("invalid execution result state root: zero hash")
	}
	
	// 3.2. Verify the enclave ID and its permissions
	if len(executionProofResult.EnclaveID) > 0 {
		v.log.Debug(fmt.Sprintf("Verifying enclave authorization for ID: %x", executionProofResult.EnclaveID))
		
		// Production-ready enclave authorization check
		authorized, permission, err := v.verifyEnclaveAuthorization(executionProofResult.EnclaveID)
		if err != nil {
			v.log.Error(fmt.Sprintf("Failed to verify enclave authorization: %v", err))
			return false, fmt.Errorf("enclave authorization check failed: %w", err)
		}
		if !authorized {
			v.log.Error(fmt.Sprintf("Unauthorized enclave ID: %x", executionProofResult.EnclaveID))
			return false, fmt.Errorf("unauthorized enclave ID: %x", executionProofResult.EnclaveID)
		}
		
		// In a real implementation, we'd extract the contract ID from executionProofResult
		// For demonstration purposes, we're using a dummy contract ID
		contractID := executionProofResult.StateRoot[:32] // Using first 32 bytes of state root as dummy contract ID
		
		// Verify enclave has permissions for this contract/transaction type
		if !permission.CanExecuteContract(contractID) {
			v.log.Error(fmt.Sprintf("Enclave lacks permission for contract: %x", contractID))
			return false, fmt.Errorf("enclave lacks permission for contract: %x", contractID)
		}
	}
	
	// 3.3. Record detailed execution metrics for monitoring
	// In a production system, we'd extract real transaction metrics
	// For demonstration purposes, we're using dummy data
	execMetrics := &ExecutionMetrics{
		TxID:           fmt.Sprintf("%x", executionProofResult.TxID), // Using TxID directly
		ContractID:     fmt.Sprintf("%x", executionProofResult.StateRoot[:32]), // Using first 32 bytes of state root as dummy contract ID
		GasUsed:        1000000, // Example gas
		ExecutionTime:  100 * time.Millisecond, // Example time
		Timestamp:      time.Now(),
		EnclaveID:      fmt.Sprintf("%x", executionProofResult.EnclaveID),
		OutputSize:     len(executionProofResult.Signature),
		StateRootHash:  fmt.Sprintf("%x", executionProofResult.StateRoot),
		Success:        true,
	}
	
	// Record metrics for monitoring and analysis
	v.recordExecutionMetrics(execMetrics)
	
	v.log.Info(fmt.Sprintf("Successfully verified execution for tx %s",
		executionProofResult.TxID))

	return valid, nil
}



// VerifyProofBatch efficiently verifies multiple proofs in a batch to maximize throughput
func (v *StatelessVerifierImpl) VerifyProofBatch(ctx context.Context, proofs []core.StatelessProof) ([]bool, error) {
	v.log.Debug(fmt.Sprintf("Verifying batch of %d proofs", len(proofs)))

	// Validate batch size to prevent DoS attacks
	if len(proofs) > v.config.MaxBatchSize {
		v.log.Warn(fmt.Sprintf("Batch size exceeds maximum allowed: %d > %d", len(proofs), v.config.MaxBatchSize))
		return nil, ErrBatchSizeTooLarge
	}

	// Prepare results array
	results := make([]bool, len(proofs))

	// Fast path: empty batch
	if len(proofs) == 0 {
		return results, nil
	}

	// Fast path: single proof
	if len(proofs) == 1 {
		result, err := v.VerifyProof(ctx, proofs[0])
		if err != nil {
			return nil, err
		}
		results[0] = result
		return results, nil
	}

	// Use parallel verification for larger batches
	return v.verifyProofBatchParallel(ctx, proofs)
}

// getCacheKey generates a cache key for a proof
func (v *StatelessVerifierImpl) getCacheKey(proof core.StatelessProof) string {
	// Use hash of serialized proof as cache key
	proofBytes, err := proof.Serialize()
	if err != nil {
		// If serialization fails, use root hash as fallback
		rootHash := proof.RootHash()
		return fmt.Sprintf("%s:%x", proof.ProofType(), rootHash)
	}
	
	// Compute SHA-256 hash of proof bytes
	hash := sha256.Sum256(proofBytes)
	return fmt.Sprintf("%s:%x", proof.ProofType(), hash)
}

// verifyEnclaveAuthorization checks if an enclave is authorized and retrieves its permissions
func (v *StatelessVerifierImpl) verifyEnclaveAuthorization(enclaveID []byte) (bool, *EnclavePermission, error) {
	// Convert enclave ID to string for map lookup
	enclaveIDStr := fmt.Sprintf("%x", enclaveID)
	
	// Check enclave authorization
	v.enclaveMutex.RLock()
	permission, exists := v.authorizedEnclaves[enclaveIDStr]
	v.enclaveMutex.RUnlock()
	
	if !exists {
		// In production: Check against an authorization service or registry
		// For now, we'll check if this is a known test enclave ID
		if bytes.Equal(enclaveID, []byte("trusted-test-enclave-id")) {
			// Create a new permission for the trusted test enclave
			newPermission := EnclavePermission{
				ID:                 enclaveIDStr,
				AllowedContracts:   nil, // Allow all contracts
				RegionalRestrictions: []string{"us-west", "eu-central"},
				MaxGasLimit:       10000000,
				IsActive:          true,
				LastUpdated:       time.Now(),
			}
			
			// Add to authorized enclaves
			v.enclaveMutex.Lock()
			v.authorizedEnclaves[enclaveIDStr] = newPermission
			v.enclaveMutex.Unlock()
			
			return true, &newPermission, nil
		}
		
		return false, nil, ErrUnauthorizedEnclave
	}
	
	// Check if enclave is active
	if !permission.IsActive {
		return false, nil, fmt.Errorf("enclave is not active: %s", enclaveIDStr)
	}
	
	// For production, add additional security checks:
	// 1. Check TEE measurement via advanced attestation service
	// 2. Verify regional compliance
	// 3. Verify root hash integrity
	
	return true, &permission, nil
}

// recordExecutionMetrics records metrics for monitoring and analysis
func (v *StatelessVerifierImpl) recordExecutionMetrics(metrics *ExecutionMetrics) {
	// Add to metrics history with a cap
	v.metricsMutex.Lock()
	v.metricHistory = append(v.metricHistory, metrics)
	
	// Keep only the most recent 1000 metrics
	if len(v.metricHistory) > 1000 {
		v.metricHistory = v.metricHistory[len(v.metricHistory)-1000:]
	}
	v.metricsMutex.Unlock()
	
	// Log metrics for monitoring
	v.log.Info(fmt.Sprintf(
		"Execution metrics - TxID: %s, Contract: %s, Gas: %d, Time: %v, Enclave: %s",
		metrics.TxID,
		metrics.ContractID,
		metrics.GasUsed,
		metrics.ExecutionTime,
		metrics.EnclaveID,
	))
	
	// In production: Send metrics to monitoring system
	// This could be a Prometheus endpoint, a metrics aggregator, or a logging service
}

// checkRateLimit implements rate limiting for verification requests
func (v *StatelessVerifierImpl) checkRateLimit(source string) error {
	v.rateLimiter.mutex.Lock()
	defer v.rateLimiter.mutex.Unlock()
	
	// Get or create counter for source
	counter, exists := v.rateLimiter.requestsBySource[source]
	if !exists {
		counter = &RequestCounter{
			count:      0,
			timestamps: make([]time.Time, 0, 100),
		}
		v.rateLimiter.requestsBySource[source] = counter
	}
	
	// Clean up old timestamps (older than 1 minute)
	now := time.Now()
	valid := 0
	for _, ts := range counter.timestamps {
		if now.Sub(ts) < time.Minute {
			if valid != len(counter.timestamps) {
				counter.timestamps[valid] = ts
			}
			valid++
		}
	}
	counter.timestamps = counter.timestamps[:valid]
	
	// Check if rate limit is exceeded
	if len(counter.timestamps) >= v.rateLimiter.maxRequestsPerMin {
		return ErrRateLimitExceeded
	}
	
	// Add current timestamp
	counter.timestamps = append(counter.timestamps, now)
	counter.count++
	
	return nil
}

// decompressRLE implements Run-Length Encoding decompression
func decompressRLE(data []byte) ([]byte, error) {
	if len(data) < 2 {
		return data, nil // Too small for RLE
	}
	
	result := make([]byte, 0, len(data)*2) // Preallocate with some room
	
	for i := 0; i < len(data); i++ {
		// Check if we have at least 2 bytes left
		if i+1 >= len(data) {
			// Add last byte if it's not part of an RLE sequence
			result = append(result, data[i])
			break
		}
		
		// Get the current byte and count
		curByte := data[i]
		count := int(data[i+1])
		
		// RLE marker detected
		if curByte == 0xFF && count > 0 {
			// Need at least 3 bytes for complete RLE sequence
			if i+2 >= len(data) {
				return nil, fmt.Errorf("incomplete RLE sequence at position %d", i)
			}
			
			// Get the byte to repeat
			repeatedByte := data[i+2]
			
			// Add the repeated byte 'count' times
			for j := 0; j < count; j++ {
				result = append(result, repeatedByte)
			}
			
			// Skip the RLE marker, count, and value bytes
			i += 2
		} else {
			// Not an RLE sequence, add the byte as is
			result = append(result, curByte)
		}
	}
	
	return result, nil
}

// decompressDictionary decompresses dictionary-encoded data
func decompressDictionary(data []byte, dictionary []DictionaryEntry) ([]byte, error) {
	if len(data) == 0 {
		return data, nil
	}
	
	result := make([]byte, 0, len(data)*2) // Preallocate with some room
	
	i := 0
	for i < len(data) {
		// Check for dictionary tokens
		matched := false
		for _, entry := range dictionary {
			tokenLen := len(entry.Token)
			
			// Check if we have enough bytes left and the token matches
			if i+tokenLen <= len(data) && bytes.Equal(data[i:i+tokenLen], entry.Token) {
				// Found a dictionary match, add the expanded value
				result = append(result, entry.Value...)
				i += tokenLen
				matched = true
				break
			}
		}
		
		if !matched {
			// Not a dictionary token, add the byte as is
			result = append(result, data[i])
			i++
		}
	}
	
	return result, nil
}

// decompressDelta decompresses delta-encoded data
func decompressDelta(data []byte) ([]byte, error) {
	if len(data) < 2 {
		return data, nil // Too small for delta encoding
	}
	
	result := make([]byte, len(data))
	
	// First byte is stored as-is
	result[0] = data[0]
	
	// Subsequent bytes are deltas from previous byte
	for i := 1; i < len(data); i++ {
		// For each byte, add the delta to the previous byte
		result[i] = result[i-1] + data[i]
	}
	
	return result, nil
}

// decompressHybrid handles multiple compression algorithms in sequence
func decompressHybrid(data []byte, compressionHeader byte, dictionary []DictionaryEntry) ([]byte, error) {
	// Extract compression flags from header
	hasDictionary := (compressionHeader & 0x01) != 0
	hasRLE := (compressionHeader & 0x02) != 0
	hasDelta := (compressionHeader & 0x04) != 0
	
	result := data[1:] // Skip the header byte
	var err error
	
	// Apply decompressions in reverse order of compression
	if hasDelta {
		result, err = decompressDelta(result)
		if err != nil {
			return nil, fmt.Errorf("delta decompression failed: %w", err)
		}
	}
	
	if hasRLE {
		result, err = decompressRLE(result)
		if err != nil {
			return nil, fmt.Errorf("RLE decompression failed: %w", err)
		}
	}
	
	if hasDictionary {
		result, err = decompressDictionary(result, dictionary)
		if err != nil {
			return nil, fmt.Errorf("dictionary decompression failed: %w", err)
		}
	}
	
	return result, nil
}

// decompressData handles all compression types
func decompressData(data []byte) ([]byte, error) {
	if len(data) == 0 {
		return data, nil
	}
	
	// First byte indicates compression type
	compressionType := CompressionType(data[0])
	
	switch compressionType {
	case CompressionNone:
		return data[1:], nil // Skip compression type byte
		
	case CompressionRLE:
		return decompressRLE(data[1:]) // Skip compression type byte
		
	case CompressionDictionary:
		return decompressDictionary(data[1:], commonDictionary)
		
	case CompressionDelta:
		return decompressDelta(data[1:])
		
	case CompressionHybrid:
		if len(data) < 2 {
			return nil, fmt.Errorf("hybrid compression header missing")
		}
		return decompressHybrid(data[1:], data[1], commonDictionary)
		
	default:
		return nil, fmt.Errorf("unknown compression type: %d", compressionType)
	}
}

// Ensure StatelessVerifierImpl implements core.StatelessVerifier
var _ core.StatelessVerifier = (*StatelessVerifierImpl)(nil)

// DefaultVerifierConfig returns the default verifier configuration
func DefaultVerifierConfig() VerifierConfig {
	return VerifierConfig{
		MaxBatchSize:     DefaultMaxBatchSize,
		CacheSize:        DefaultCacheSize,
		MaxProofSize:     DefaultMaxProofSize,
		ParallelWorkers:  DefaultParallelWorkers,
		CacheTTL:         DefaultCacheTTL,
	}
}

// VerifierMetrics tracks performance metrics for the verifier
type VerifierMetrics struct {
	// Number of proofs verified
	VerifiedCount uint64
	
	// Number of failed verifications
	FailedCount uint64
	
	// Number of cache hits
	CacheHits uint64
	
	// Number of cache misses
	CacheMisses uint64
	
	// Number of batch verifications
	BatchVerifications uint64
	
	// Average verification time in milliseconds
	AvgVerificationTimeMs float64
	
	// Total verification time
	TotalVerificationTime time.Duration
	
	// Mutex for thread-safe updates
	Mutex sync.RWMutex
	
	// RequestErrorCount tracks request failures by source for monitoring and abuse detection
	RequestErrorCount map[string]int
	
	// RequestSuccessCount tracks successful requests by source
	RequestSuccessCount map[string]int
	
	// Distributed cache metrics
	RemoteCacheHits uint64
	RemoteCacheMisses uint64
	RemoteCacheErrors uint64
	
	// Enhanced batch attestation metrics
	BatchAttestationCount uint64
	BatchAttestationSuccessRate float64
	BatchAttestationProcessingTime time.Duration
}

// NewVerifierMetrics creates a new verifier metrics instance
func NewVerifierMetrics() *VerifierMetrics {
	return &VerifierMetrics{
		RequestErrorCount:   make(map[string]int),
		RequestSuccessCount: make(map[string]int),
	}
}

// CacheEntry represents a cached verification result with timestamp
type CacheEntry struct {
	Result    bool
	Timestamp time.Time
}

// AttestationService is defined in verifier.go

// BatchAttestationService extends AttestationService with batch verification capabilities
type BatchAttestationService interface {
	AttestationService
	
	// VerifyAttestationBatch verifies multiple attestations in a single operation
	VerifyAttestationBatch(attestations [][]byte) (bool, error)
}

// AdvancedAttestationService extends AttestationService with robust TEE measurement verification
type AdvancedAttestationService interface {
	AttestationService
	
	// VerifyTEEMeasurement verifies the TEE measurement against trusted values
	VerifyTEEMeasurement(measurement []byte, teeType string) (bool, error)
	
	// VerifyRegionalCompliance verifies the attestation complies with regional regulations
	VerifyRegionalCompliance(regionID string) (bool, error)
	
	// VerifyRootHash checks if the provided root hash is valid and trusted.
	VerifyRootHash(rootHash []byte) (bool, error)
}

// EnclavePermission represents permission settings for an authorized enclave
type EnclavePermission struct {
	ID string
	AllowedContracts [][]byte
	RegionalRestrictions []string
	MaxGasLimit uint64
	IsActive bool
	LastUpdated time.Time
}

// CanExecuteContract checks if the enclave has permission to execute a contract
func (p *EnclavePermission) CanExecuteContract(contractID []byte) bool {
	if !p.IsActive {
		return false
	}
	
	// If no allowed contracts specified, allow all
	if len(p.AllowedContracts) == 0 {
		return true
	}
	
	// Check if contract is in the allowed list
	for _, allowed := range p.AllowedContracts {
		if bytes.Equal(contractID, allowed) {
			return true
		}
	}
	
	return false
}

// ExecutionMetrics contains detailed metrics for execution proof verification
type ExecutionMetrics struct {
	TxID string
	ContractID string
	GasUsed uint64
	ExecutionTime time.Duration
	Timestamp time.Time
	EnclaveID string
	OutputSize int
	StateRootHash string
	Success bool
	ErrorDetails string
}

// RequestCounter tracks request counts with timestamps for rate limiting
type RequestCounter struct {
	count int
	timestamps []time.Time
}

// RateLimiter provides rate limiting for verification requests
type RateLimiter struct {
	requestsBySource map[string]*RequestCounter
	mutex sync.RWMutex
	maxRequestsPerMin int
	cleanupInterval time.Duration
}

// DistributedCacheProvider defines an interface for distributed caching operations
type DistributedCacheProvider interface {
	// Get retrieves a value from the distributed cache
	Get(key string) (interface{}, bool)
	
	// Set stores a value in the distributed cache with expiration
	Set(key string, value interface{}, expiration time.Duration) error
	
	// Delete removes a value from the distributed cache
	Delete(key string) error
	
	// Has checks if a key exists in the distributed cache
	Has(key string) bool
}

// NoOpDistributedCache provides a dummy implementation that does nothing
type NoOpDistributedCache struct{}

// Get implements DistributedCacheProvider.Get
func (n *NoOpDistributedCache) Get(key string) (interface{}, bool) {
	return nil, false
}

// Set implements DistributedCacheProvider.Set
func (n *NoOpDistributedCache) Set(key string, value interface{}, expiration time.Duration) error {
	return nil
}

// Delete implements DistributedCacheProvider.Delete
func (n *NoOpDistributedCache) Delete(key string) error {
	return nil
}

// Has implements DistributedCacheProvider.Has
func (n *NoOpDistributedCache) Has(key string) bool {
	return false
}

// BatchAttestationMetadata contains metadata for batch attestation results
type BatchAttestationMetadata struct {
	// How many attestations in this batch
	Count int
	
	// When this batch was processed
	Timestamp time.Time
	
	// Processing time for the entire batch
	ProcessingTime time.Duration
	
	// Source identifier (typically service ID)
	Source string
	
	// Success rate for this batch (0.0-1.0)
	SuccessRate float64
}

// StatelessVerifierImpl implements the core.StatelessVerifier interface with enhanced features
type StatelessVerifierImpl struct {
	// Registry of proof verifiers by type
	proofVerifiers    map[string]func(context.Context, []byte) (bool, error)
	
	// Verification result cache
	verificationCache map[string]CacheEntry
	cacheMutex        sync.RWMutex
	
	// Attestation service for signature verification
	attestationSvc    AttestationService
	
	// Configuration and performance settings
	config            VerifierConfig
	
	// Logging and metrics
	log logging.Logger
	metrics *VerifierMetrics
	
	// Production-ready enhancements
	authorizedEnclaves map[string]EnclavePermission
	enclaveMutex      sync.RWMutex
	rateLimiter       *RateLimiter
	metricHistory     []*ExecutionMetrics
	metricsMutex      sync.RWMutex
	
	// Distributed caching support
	distCache         DistributedCacheProvider
	distCacheEnabled  bool
	
	// Enhanced batch attestation
	batchAttestationMutex sync.RWMutex
	batchAttestationMetadata []*BatchAttestationMetadata
	batchAttestationHashes map[string]bool // Fast lookup for batch attestation results
}

// Ensure StatelessVerifierImpl implements core.StatelessVerifier
var _ core.StatelessVerifier = (*StatelessVerifierImpl)(nil)
