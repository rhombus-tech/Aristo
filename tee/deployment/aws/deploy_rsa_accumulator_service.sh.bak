#!/bin/bash
# Deploy high-performance RSA accumulator service for NASDAQ TEE infrastructure
# This works alongside the parameter validators to provide the cryptographic accumulator

set -e

# Colors for output
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
RED='\033[0;31m'
NC='\033[0m' # No Color

# NASDAQ SSH Key path
SSH_KEY="~/nasdaq-tee-key.pem"

# Check if SSH key exists
if [ ! -f "$(eval echo $SSH_KEY)" ]; then
    echo -e "${RED}NASDAQ SSH key not found: $SSH_KEY${NC}"
    echo -e "${YELLOW}Please ensure ~/nasdaq-tee-key.pem exists${NC}"
    exit 1
fi

# SSH options
SSH_OPTS="-o StrictHostKeyChecking=no -o ConnectTimeout=10 -i $(eval echo $SSH_KEY)"

echo -e "${GREEN}=== Deploying High-Performance RSA Accumulator Service ===${NC}"

# Hard-coded node information - same nodes as parameter validators
declare -a NODES=(
  "54.172.109.130,SGX,1"  # SGX Node 1
  "54.236.21.15,SEV,1"    # SEV Node 1
)

# Define ports for RSA accumulator service (different from validator ports)
SGX_ACCUMULATOR_PORT=7100
SEV_ACCUMULATOR_PORT=7101

# Base project directory
PROJECT_DIR="/Users/talzisckind/Downloads/aristo-fresh 2"

# Source file paths
GO_RSA_SOURCE="$PROJECT_DIR/tee/accumulator/high_perf_rsa.go"
RUST_RSA_SOURCE="$PROJECT_DIR/execution/accumulator/src/rsa_accumulator.rs"

# Output binary paths
GO_RSA_BINARY="$PROJECT_DIR/tee/accumulator/high_perf_rsa_accumulator"
RUST_RSA_BINARY="$PROJECT_DIR/execution/accumulator/target/wasm32-wasi/release/rsa_accumulator.wasm"

# Prepare high-performance RSA accumulators
echo -e "${GREEN}Building high-performance RSA accumulator binaries...${NC}"

# Build Go RSA accumulator for SGX
build_go_accumulator() {
    echo -e "${GREEN}Building Go high-performance RSA accumulator for SGX...${NC}"
    
    # Check if Go is installed
    if ! command -v go &> /dev/null; then
        echo -e "${RED}Go not found. Please install Go to build the accumulator.${NC}"
        exit 1
    fi
}

# Main execution

# Build the RSA accumulator binaries
build_go_accumulator
build_rust_accumulator

# Loop through each node and deploy the RSA accumulator service
for NODE in "${NODES[@]}"; do
    IFS=',' read -r IP TYPE PAIR_ID <<< "$NODE"
    
    # Deploy RSA accumulator
    deploy_rsa_accumulator "$IP" "$TYPE" "$PAIR_ID"
    
    # Start RSA accumulator service
    start_rsa_accumulator "$IP" "$TYPE"
done

echo -e "\n${GREEN}RSA Accumulator Service Deployment Complete${NC}"
echo -e "${YELLOW}Parameter validators on ports 7090/7091 should connect to RSA services on ports 7100/7101${NC}"

    
    # Create a main.go file that uses our high_perf_rsa.go implementation
    cat > "$PROJECT_DIR/tee/accumulator/rsa_accumulator_main.go" << 'EOF'
package main

import (
    "flag"
    "fmt"
    "log"
    "net/http"
    "time"
    
    "github.com/rhombus-tech/vm/tee/accumulator"
)

func main() {
    // Parse command line flags
    port := flag.Int("port", 7100, "Port to listen on")
    enableLengthPrefix := flag.Bool("enable-length-prefix", true, "Enable length-prefixed format support")
    enableDirectFormat := flag.Bool("enable-direct-format", true, "Enable direct format support")
    batchSize := flag.Int("batch-size", 1000, "Maximum batch size for accumulation")
    parallelism := flag.Int("parallelism", 16, "Number of parallel workers")
    flag.Parse()
    
    // Initialize the high-performance RSA accumulator
    options := accumulator.HighPerfRsaOptions{
        BatchSize: *batchSize,
        Parallelism: *parallelism,
        AsyncEnabled: true,
        BatchTimeout: 200 * time.Millisecond,
        ModulusBits: 2048,
        SupportLengthPrefix: *enableLengthPrefix,
        SupportDirectFormat: *enableDirectFormat,
    }
    
    rsaClient, err := accumulator.NewHighPerfRsaClient("tee-sgx", "SGX", options)
    if err != nil {
        log.Fatalf("Failed to initialize RSA accumulator: %v", err)
    }
    defer rsaClient.Close()
    
    // Start the HTTP server
    addr := fmt.Sprintf(":%d", *port)
    log.Printf("Starting high-performance RSA accumulator service on %s", addr)
    log.Printf("Parameter format support: Length-prefixed=%v, Direct=%v", *enableLengthPrefix, *enableDirectFormat)
    log.Printf("Performance configuration: Batch size=%d, Parallelism=%d", *batchSize, *parallelism)
    
    // Register handlers
    http.HandleFunc("/add", rsaClient.HandleAddElement)
    http.HandleFunc("/verify", rsaClient.HandleVerifyWitness)
    http.HandleFunc("/metrics", rsaClient.HandleMetrics)
    
    log.Fatal(http.ListenAndServe(addr, nil))
}
EOF

    # Build the Go binary
    cd "$PROJECT_DIR/tee/accumulator" && go build -o "$GO_RSA_BINARY" rsa_accumulator_main.go
    
    if [ ! -f "$GO_RSA_BINARY" ]; then
        echo -e "${RED}Failed to build Go RSA accumulator binary${NC}"
        exit 1
    fi
}

# Main execution

# Build the RSA accumulator binaries
build_go_accumulator
build_rust_accumulator

# Loop through each node and deploy the RSA accumulator service
for NODE in "${NODES[@]}"; do
    IFS=',' read -r IP TYPE PAIR_ID <<< "$NODE"
    
    # Deploy RSA accumulator
    deploy_rsa_accumulator "$IP" "$TYPE" "$PAIR_ID"
    
    # Start RSA accumulator service
    start_rsa_accumulator "$IP" "$TYPE"
done

echo -e "\n${GREEN}RSA Accumulator Service Deployment Complete${NC}"
echo -e "${YELLOW}Parameter validators on ports 7090/7091 should connect to RSA services on ports 7100/7101${NC}"

    
    echo -e "${GREEN}✓ Successfully built Go RSA accumulator: $GO_RSA_BINARY${NC}"
}

# Build Rust RSA accumulator for SEV
build_rust_accumulator() {
    echo -e "${GREEN}Building Rust high-performance RSA accumulator for SEV...${NC}"
    
    # Check if Rust is installed
    if ! command -v cargo &> /dev/null; then
        echo -e "${RED}Rust not found. Please install Rust to build the accumulator.${NC}"
        exit 1
    fi
}

# Main execution

# Build the RSA accumulator binaries
build_go_accumulator
build_rust_accumulator

# Loop through each node and deploy the RSA accumulator service
for NODE in "${NODES[@]}"; do
    IFS=',' read -r IP TYPE PAIR_ID <<< "$NODE"
    
    # Deploy RSA accumulator
    deploy_rsa_accumulator "$IP" "$TYPE" "$PAIR_ID"
    
    # Start RSA accumulator service
    start_rsa_accumulator "$IP" "$TYPE"
done

echo -e "\n${GREEN}RSA Accumulator Service Deployment Complete${NC}"
echo -e "${YELLOW}Parameter validators on ports 7090/7091 should connect to RSA services on ports 7100/7101${NC}"

    
    # Check if wasm32-wasi target is installed
    if ! rustup target list | grep -q "wasm32-wasi (installed)"; then
        echo -e "${YELLOW}Installing wasm32-wasi target...${NC}"
        rustup target add wasm32-wasi
    fi
}

# Main execution

# Build the RSA accumulator binaries
build_go_accumulator
build_rust_accumulator

# Loop through each node and deploy the RSA accumulator service
for NODE in "${NODES[@]}"; do
    IFS=',' read -r IP TYPE PAIR_ID <<< "$NODE"
    
    # Deploy RSA accumulator
    deploy_rsa_accumulator "$IP" "$TYPE" "$PAIR_ID"
    
    # Start RSA accumulator service
    start_rsa_accumulator "$IP" "$TYPE"
done

echo -e "\n${GREEN}RSA Accumulator Service Deployment Complete${NC}"
echo -e "${YELLOW}Parameter validators on ports 7090/7091 should connect to RSA services on ports 7100/7101${NC}"

    
    # Build the Rust binary
    cd "$PROJECT_DIR/execution/accumulator" && \
    cargo build --target wasm32-wasi --release
    
    if [ ! -f "$RUST_RSA_BINARY" ]; then
        echo -e "${RED}Failed to build Rust RSA accumulator binary${NC}"
        exit 1
    fi
}

# Main execution

# Build the RSA accumulator binaries
build_go_accumulator
build_rust_accumulator

# Loop through each node and deploy the RSA accumulator service
for NODE in "${NODES[@]}"; do
    IFS=',' read -r IP TYPE PAIR_ID <<< "$NODE"
    
    # Deploy RSA accumulator
    deploy_rsa_accumulator "$IP" "$TYPE" "$PAIR_ID"
    
    # Start RSA accumulator service
    start_rsa_accumulator "$IP" "$TYPE"
done

echo -e "\n${GREEN}RSA Accumulator Service Deployment Complete${NC}"
echo -e "${YELLOW}Parameter validators on ports 7090/7091 should connect to RSA services on ports 7100/7101${NC}"

    
    echo -e "${GREEN}✓ Successfully built Rust RSA accumulator: $RUST_RSA_BINARY${NC}"
}

# Deploy RSA accumulator service to target node
deploy_rsa_accumulator() {
    local IP=$1
    local TYPE=$2
    local PAIR_ID=$3
    
    echo -e "\n${GREEN}Deploying high-performance RSA accumulator service to $TYPE node (Pair $PAIR_ID) at $IP...${NC}"
    
    # Choose appropriate port based on node type
    local PORT
    if [ "$TYPE" == "SGX" ]; then
        PORT=$SGX_ACCUMULATOR_PORT
    else
        PORT=$SEV_ACCUMULATOR_PORT
    fi
}

# Main execution

# Build the RSA accumulator binaries
build_go_accumulator
build_rust_accumulator

# Loop through each node and deploy the RSA accumulator service
for NODE in "${NODES[@]}"; do
    IFS=',' read -r IP TYPE PAIR_ID <<< "$NODE"
    
    # Deploy RSA accumulator
    deploy_rsa_accumulator "$IP" "$TYPE" "$PAIR_ID"
    
    # Start RSA accumulator service
    start_rsa_accumulator "$IP" "$TYPE"
done

echo -e "\n${GREEN}RSA Accumulator Service Deployment Complete${NC}"
echo -e "${YELLOW}Parameter validators on ports 7090/7091 should connect to RSA services on ports 7100/7101${NC}"

    
    # Kill any existing RSA accumulator processes
    ssh $SSH_OPTS ubuntu@$IP "pkill -f rsa_accumulator || true"
    
    # Create service directory
    ssh $SSH_OPTS ubuntu@$IP "mkdir -p ~/rsa_accumulator_service"
    
    # Create configuration for RSA accumulator service
    ssh $SSH_OPTS ubuntu@$IP "cat > ~/rsa_accumulator_service/config.json << EOF
{
    \"listen_address\": \"0.0.0.0:$PORT\",
    \"node_type\": \"$TYPE\",
    \"pair_id\": $PAIR_ID,
    \"support_direct_format\": true,
    \"support_length_prefix\": true,
    \"max_batch_size\": 1000,
    \"parallelism\": 16,
    \"performance_target_tps\": 50000
}
EOF"
    
    # Deploy appropriate RSA accumulator binary based on node type
    if [ "$TYPE" == "SGX" ]; then
        # Deploy Go RSA accumulator for SGX
        echo -e "${GREEN}Deploying Go high-performance RSA accumulator to SGX node...${NC}"
        scp $SSH_OPTS "$GO_RSA_BINARY" ubuntu@$IP:~/rsa_accumulator_service/rsa_accumulator
    else
        # Deploy Rust RSA accumulator for SEV
        echo -e "${GREEN}Deploying Rust high-performance RSA accumulator to SEV node...${NC}"
        scp $SSH_OPTS "$RUST_RSA_BINARY" ubuntu@$IP:~/rsa_accumulator_service/rsa_accumulator.wasm
        
        # Deploy Enarx for running the Wasm module
        ssh $SSH_OPTS ubuntu@$IP "if ! command -v enarx &> /dev/null; then
            curl -sSf https://sh.enarx.dev | sh
            export PATH=\"$HOME/.enarx/bin:$PATH\"
        fi
}

# Main execution

# Build the RSA accumulator binaries
build_go_accumulator
build_rust_accumulator

# Loop through each node and deploy the RSA accumulator service
for NODE in "${NODES[@]}"; do
    IFS=',' read -r IP TYPE PAIR_ID <<< "$NODE"
    
    # Deploy RSA accumulator
    deploy_rsa_accumulator "$IP" "$TYPE" "$PAIR_ID"
    
    # Start RSA accumulator service
    start_rsa_accumulator "$IP" "$TYPE"
done

echo -e "\n${GREEN}RSA Accumulator Service Deployment Complete${NC}"
echo -e "${YELLOW}Parameter validators on ports 7090/7091 should connect to RSA services on ports 7100/7101${NC}"
"
    fi
}

# Main execution

# Build the RSA accumulator binaries
build_go_accumulator
build_rust_accumulator

# Loop through each node and deploy the RSA accumulator service
for NODE in "${NODES[@]}"; do
    IFS=',' read -r IP TYPE PAIR_ID <<< "$NODE"
    
    # Deploy RSA accumulator
    deploy_rsa_accumulator "$IP" "$TYPE" "$PAIR_ID"
    
    # Start RSA accumulator service
    start_rsa_accumulator "$IP" "$TYPE"
done

echo -e "\n${GREEN}RSA Accumulator Service Deployment Complete${NC}"
echo -e "${YELLOW}Parameter validators on ports 7090/7091 should connect to RSA services on ports 7100/7101${NC}"

    
    # Create a test script for RSA accumulator
    ssh $SSH_OPTS ubuntu@$IP "cat > ~/rsa_accumulator_service/test_accumulator.py << 'EOF'
import requests
import json
import struct
import time
import sys

def test_length_prefixed_format(host, port):
    # Format as length-prefixed: [4-byte length][data]
    data = {'executor': 'test', 'measurement': 'accumulator_test'}
    data_bytes = json.dumps(data).encode('utf-8')
    length = len(data_bytes)
    prefix = struct.pack('<I', length)  # Little-endian u32
    payload = prefix + data_bytes
    
    print(f"Testing accumulator with length-prefixed format: {length} bytes with prefix")
    response = requests.post(f"http://{host}:{port}/add", data=payload)
    return response.json()

def test_direct_format(host, port):
    # Format as direct (no length prefix)
    data = {'executor': 'test', 'measurement': 'direct_test'}
    data_bytes = json.dumps(data).encode('utf-8')
    
    print(f"Testing accumulator with direct format: {len(data_bytes)} bytes")
    response = requests.post(f"http://{host}:{port}/add", data=data_bytes)
    return response.json()

def test_metrics(host, port):
    response = requests.get(f"http://{host}:{port}/metrics")
    return response.json()

def main():
    host = 'localhost'
    port = int(sys.argv[1]) if len(sys.argv) > 1 else 7100
    
    # Test length-prefixed format
    result1 = test_length_prefixed_format(host, port)
    print(f"Length-prefixed result: {json.dumps(result1, indent=2)}")
    
    # Test direct format
    result2 = test_direct_format(host, port)
    print(f"Direct format result: {json.dumps(result2, indent=2)}")
    
    # Check metrics
    time.sleep(1)  # Wait for metrics to update
    metrics = test_metrics(host, port)
    print(f"\nPerformance Metrics:\n{json.dumps(metrics, indent=2)}")

if __name__ == '__main__':
    main()
EOF"

    # Install Python requests library for testing
    ssh $SSH_OPTS ubuntu@$IP "sudo apt-get update && sudo apt-get install -y python3-requests || true"
}

# Start the RSA accumulator service
start_rsa_accumulator() {
    local IP=$1
    local TYPE=$2
    
    # Choose appropriate port based on node type
    local PORT
    if [ "$TYPE" == "SGX" ]; then
        PORT=$SGX_ACCUMULATOR_PORT
    else
        PORT=$SEV_ACCUMULATOR_PORT
    fi
}

# Main execution

# Build the RSA accumulator binaries
build_go_accumulator
build_rust_accumulator

# Loop through each node and deploy the RSA accumulator service
for NODE in "${NODES[@]}"; do
    IFS=',' read -r IP TYPE PAIR_ID <<< "$NODE"
    
    # Deploy RSA accumulator
    deploy_rsa_accumulator "$IP" "$TYPE" "$PAIR_ID"
    
    # Start RSA accumulator service
    start_rsa_accumulator "$IP" "$TYPE"
done

echo -e "\n${GREEN}RSA Accumulator Service Deployment Complete${NC}"
echo -e "${YELLOW}Parameter validators on ports 7090/7091 should connect to RSA services on ports 7100/7101${NC}"

    
    echo -e "${GREEN}Starting $TYPE high-performance RSA accumulator service on $IP:$PORT...${NC}"
    
    if [ "$TYPE" == "SGX" ]; then
        # Start Go RSA accumulator
        ssh $SSH_OPTS ubuntu@$IP "cd ~/rsa_accumulator_service && chmod +x rsa_accumulator && nohup ./rsa_accumulator --port=$PORT --enable-direct-format=true --enable-length-prefix=true --batch-size=1000 --parallelism=16 > rsa_accumulator.log 2>&1 &"
        ssh $SSH_OPTS ubuntu@$IP "cd ~/rsa_accumulator_service && echo \$! > rsa_accumulator.pid"
    else
        # Start Rust RSA accumulator with Enarx for SEV
        ssh $SSH_OPTS ubuntu@$IP "cd ~/rsa_accumulator_service && export PATH=\"$HOME/.enarx/bin:$PATH\" && nohup enarx run --wasmcfgfile=config.json rsa_accumulator.wasm -- --port $PORT --enable-direct-format=true --enable-length-prefix=true > rsa_accumulator.log 2>&1 &"
        ssh $SSH_OPTS ubuntu@$IP "cd ~/rsa_accumulator_service && echo \$! > rsa_accumulator.pid"
    fi
}

# Main execution

# Build the RSA accumulator binaries
build_go_accumulator
build_rust_accumulator

# Loop through each node and deploy the RSA accumulator service
for NODE in "${NODES[@]}"; do
    IFS=',' read -r IP TYPE PAIR_ID <<< "$NODE"
    
    # Deploy RSA accumulator
    deploy_rsa_accumulator "$IP" "$TYPE" "$PAIR_ID"
    
    # Start RSA accumulator service
    start_rsa_accumulator "$IP" "$TYPE"
done

echo -e "\n${GREEN}RSA Accumulator Service Deployment Complete${NC}"
echo -e "${YELLOW}Parameter validators on ports 7090/7091 should connect to RSA services on ports 7100/7101${NC}"

