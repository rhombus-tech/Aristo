[Unit]
Description=Go Parameter Validator Service
After=network.target

[Service]
Type=simple
User=ubuntu
WorkingDirectory=/usr/local/bin
ExecStart=/usr/local/bin/parameter_validator --port=7300 --tee-type=${TEE_TYPE} --peer-endpoint=${PEER_ENDPOINT}
Restart=always
RestartSec=5
Environment=TEE_TYPE=sgx
Environment=PEER_ENDPOINT=localhost:7301

[Install]
WantedBy=multi-user.target
