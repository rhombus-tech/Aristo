#!/usr/bin/env python3
"""
Enarx TEE Client
---------------
Client for executing WebAssembly contracts in Intel SGX and AMD SEV Trusted Execution Environments
using the Enarx framework. Supports both direct and length-prefixed parameter formats with cross-attestation
verification between different TEE types.

Usage:
  ./tee-client --node-id <node_id> --node-type <SGX|SEV> --contract <contract_id> 
               --function <function> --params <params_hex> [--format <direct|length-prefixed>]
               [--cross-attest] [--benchmark]
"""

import argparse
import base64
import binascii
import hashlib
import json
import os
import subprocess
import sys
import time
from datetime import datetime
from typing import Dict, List, Any, Optional, Tuple

# Constants
DEFAULT_ENARX_PATH = "/usr/local/bin/enarx"
WASMLANCHE_CONTRACT_PATH = "/opt/tee/contracts"
MAX_PAYLOAD_SIZE = 1024 * 1024  # 1MB

# SGX and SEV platform-specific constants
SGX_ATTESTATION_FLAGS = ["--sgx-att"]
SEV_ATTESTATION_FLAGS = ["--sev-att"]
DEFAULT_WASMI_MEMORY = "2048"

def log(message: str, level: str = "INFO"):
    """Simple logging to stdout with timestamp"""
    timestamp = datetime.now().strftime("%Y-%m-%d %H:%M:%S.%f")[:-3]
    print(f"{timestamp} - [{level}] - {message}", file=sys.stderr)

def parse_args():
    """Parse command-line arguments"""
    parser = argparse.ArgumentParser(description="Enarx TEE Client for WebAssembly contract execution")
    parser.add_argument("--node-id", required=True, help="Node ID for the TEE")
    parser.add_argument("--node-type", required=True, choices=["SGX", "SEV"], help="TEE type (SGX or SEV)")
    parser.add_argument("--contract", required=True, help="Contract ID to execute")
    parser.add_argument("--function", required=True, help="Function name to call")
    parser.add_argument("--params", required=True, help="Hex-encoded parameters")
    parser.add_argument("--format", default="length-prefixed", choices=["direct", "length-prefixed"], 
                        help="Parameter format (direct or length-prefixed)")
    parser.add_argument("--enarx-path", default=DEFAULT_ENARX_PATH, help="Path to enarx binary")
    parser.add_argument("--cross-attest", action="store_true", help="Enable cross-attestation verification")
    parser.add_argument("--benchmark", action="store_true", help="Enable performance benchmarking")
    parser.add_argument("--debug", action="store_true", help="Enable debug mode")
    parser.add_argument("--memory", default=DEFAULT_WASMI_MEMORY, help="WebAssembly memory allocation in MB")
    
    return parser.parse_args()

def validate_payload(payload: bytes, format_type: str) -> Tuple[bool, str]:
    """
    Validate payload format and size with enhanced security checks
    Returns: (is_valid, error_message)
    """
    # Size validation
    if len(payload) > MAX_PAYLOAD_SIZE:
        return False, f"Payload size ({len(payload)}) exceeds maximum allowed ({MAX_PAYLOAD_SIZE} bytes)"
    
    # Format validation for length-prefixed format
    if format_type == "length-prefixed" and len(payload) >= 4:
        length_prefix = int.from_bytes(payload[:4], byteorder='little')
        actual_length = len(payload) - 4
        
        # Validate length prefix matches actual data size
        if length_prefix != actual_length:
            return False, f"Length prefix ({length_prefix}) does not match actual data size ({actual_length})"
        
        # Check for reasonable length values to prevent integer overflow attacks
        if length_prefix <= 0 or length_prefix > MAX_PAYLOAD_SIZE:
            return False, f"Invalid length prefix: {length_prefix}"
    
    return True, ""

def run_enarx_command(args, node_type: str, debug: bool = False) -> Tuple[int, str, str]:
    """Run an enarx command with appropriate platform-specific flags"""
    
    # Add TEE-specific attestation flags
    if node_type == "SGX":
        args.extend(SGX_ATTESTATION_FLAGS)
    elif node_type == "SEV":
        args.extend(SEV_ATTESTATION_FLAGS)
    
    if debug:
        log(f"Executing: {' '.join(args)}", "DEBUG")
    
    start_time = time.time()
    
    try:
        # Execute the command with timeout
        proc = subprocess.Popen(
            args,
            stdout=subprocess.PIPE,
            stderr=subprocess.PIPE,
            text=True
        )
        
        # Wait for completion with timeout (30 seconds)
        stdout, stderr = proc.communicate(timeout=30)
        
        exec_time = time.time() - start_time
        if debug:
            log(f"Execution time: {exec_time:.2f}s", "DEBUG")
            
        return proc.returncode, stdout, stderr
        
    except subprocess.TimeoutExpired:
        log(f"Command timed out after {time.time() - start_time:.2f}s", "ERROR")
        proc.kill()
        return -1, "", "Execution timed out"
    except Exception as e:
        log(f"Command execution error: {str(e)}", "ERROR")
        return -1, "", str(e)

def execute_contract(args) -> Dict[str, Any]:
    """Execute a WebAssembly contract in the TEE using Enarx"""
    start_time = time.time()
    
    try:
        # Decode hex parameters
        try:
            params_bytes = binascii.unhexlify(args.params)
        except binascii.Error:
            return {
                "success": False,
                "error": "Invalid hex parameters",
                "execution_time_ms": 0
            }
        
        # Validate parameters
        is_valid, error_message = validate_payload(params_bytes, args.format)
        if not is_valid:
            return {
                "success": False,
                "error": error_message,
                "execution_time_ms": 0
            }
        
        # Construct the contract path
        contract_path = os.path.join(WASMLANCHE_CONTRACT_PATH, f"{args.contract}.wasm")
        if not os.path.exists(contract_path):
            return {
                "success": False,
                "error": f"Contract not found: {contract_path}",
                "execution_time_ms": 0
            }
        
        # Create a temporary file for parameters
        params_file = f"/tmp/params_{args.node_id}_{int(time.time())}.bin"
        with open(params_file, "wb") as f:
            f.write(params_bytes)
        
        # Prepare Enarx command
        enarx_cmd = [
            args.enarx_path,
            "run",
            "--wasmcfgfile", f"{contract_path}.toml",  # Configuration file
            "--memory", args.memory,                   # Memory allocation
            contract_path,                             # WASM contract
            "--function", args.function,               # Function to call
            "--params-file", params_file,              # Parameters file
            "--format", args.format,                   # Parameter format
            "--node-id", args.node_id,                 # Node ID for attestation
            "--node-type", args.node_type              # TEE type
        ]
        
        # Execute the command
        log(f"Executing contract {args.contract}.{args.function} on {args.node_type} node {args.node_id}")
        returncode, stdout, stderr = run_enarx_command(enarx_cmd, args.node_type, args.debug)
        
        # Remove the params file
        try:
            os.unlink(params_file)
        except:
            pass
        
        execution_time_ms = (time.time() - start_time) * 1000
        
        # Process execution result
        if returncode != 0:
            log(f"Contract execution failed with code {returncode}: {stderr}", "ERROR")
            return {
                "success": False,
                "error": f"Execution failed: {stderr}",
                "execution_time_ms": execution_time_ms,
                "attestation_verified": False
            }
        
        # Parse the result from stdout (should be JSON)
        try:
            result = json.loads(stdout)
            # Add execution time
            result["execution_time_ms"] = execution_time_ms
            
            # Make sure result has the standard fields
            if "success" not in result:
                result["success"] = True
                
            return result
        except json.JSONDecodeError:
            # If not JSON, return the raw output
            log(f"Could not parse JSON result: {stdout}", "WARNING")
            
            # Try to find an attestation report
            attestation_verified = "attestation verified" in stdout.lower()
            
            return {
                "success": True,
                "result": base64.b64encode(stdout.encode()).decode(),
                "result_format": "base64",
                "execution_time_ms": execution_time_ms,
                "attestation_verified": attestation_verified
            }
        
    except Exception as e:
        log(f"Error executing contract: {str(e)}", "ERROR")
        import traceback
        log(traceback.format_exc(), "ERROR")
        
        execution_time_ms = (time.time() - start_time) * 1000
        return {
            "success": False,
            "error": str(e),
            "execution_time_ms": execution_time_ms,
            "attestation_verified": False
        }

def cross_attestation(args, result: Dict[str, Any]) -> Dict[str, Any]:
    """Perform cross-attestation with another TEE type"""
    if not args.cross_attest:
        # If cross-attestation not requested, just return the original result
        return result
    
    # If execution already failed, don't attempt cross-attestation
    if not result.get("success", False):
        result["cross_attestation"] = {
            "performed": False,
            "reason": "Primary execution failed"
        }
        return result
    
    log(f"Performing cross-attestation for {args.node_id}")
    
    # Determine the other TEE type for cross-attestation
    other_type = "SGX" if args.node_type == "SEV" else "SEV"
    
    # For cross-attestation, we need to generate an attestation report file
    attestation_file = f"/tmp/attestation_{args.node_id}_{int(time.time())}.json"
    
    # Execute the same contract on the other TEE type
    cross_args = argparse.Namespace(
        node_id=f"cross-{args.node_id}",
        node_type=other_type,
        contract=args.contract,
        function=args.function,
        params=args.params,
        format=args.format,
        enarx_path=args.enarx_path,
        cross_attest=False,  # Prevent infinite recursion
        debug=args.debug,
        memory=args.memory
    )
    
    cross_result = execute_contract(cross_args)
    
    # Add cross-attestation information to the result
    result["cross_attestation"] = {
        "performed": True,
        "tee_type": other_type,
        "success": cross_result.get("success", False),
        "result_hash": hashlib.sha256(str(cross_result.get("result", "")).encode()).hexdigest(),
        "matching_result": result.get("result") == cross_result.get("result")
    }
    
    # If cross-attestation result matches, we consider this verified
    if result["cross_attestation"]["matching_result"]:
        result["attestation_verified"] = True
    
    return result

def main():
    """Main entry point"""
    args = parse_args()
    
    if args.debug:
        log("Debug mode enabled", "DEBUG")
        log(f"Arguments: {vars(args)}", "DEBUG")
    
    # Execute the contract
    start_time = time.time()
    result = execute_contract(args)
    
    # Perform cross-attestation if requested
    if args.cross_attest and result.get("success", False):
        result = cross_attestation(args, result)
    
    # Add benchmark information if requested
    if args.benchmark:
        result["benchmark"] = {
            "total_time_ms": (time.time() - start_time) * 1000,
            "node_type": args.node_type,
            "format": args.format,
            "contract": args.contract,
            "function": args.function,
            "param_size_bytes": len(binascii.unhexlify(args.params)) if args.params else 0
        }
    
    # Output the result as JSON
    print(json.dumps(result, indent=2))
    
    # Exit with appropriate code
    sys.exit(0 if result.get("success", False) else 1)

if __name__ == "__main__":
    main()
