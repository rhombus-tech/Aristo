{
  "commands": [
    "#!/bin/bash",
    "SSH_KEY=\"ssh-rsa  TEE Access Key\"",
    "# Try for Ubuntu user (common on AWS Ubuntu AMIs)",
    "if id ubuntu &>/dev/null; then",
    "  echo \"Adding SSH key for ubuntu user...\"",
    "  mkdir -p /home/ubuntu/.ssh",
    "  grep -q \"$SSH_KEY\" /home/ubuntu/.ssh/authorized_keys 2>/dev/null || echo \"$SSH_KEY\" >> /home/ubuntu/.ssh/authorized_keys",
    "  chown -R ubuntu:ubuntu /home/ubuntu/.ssh",
    "  chmod 700 /home/ubuntu/.ssh",
    "  chmod 600 /home/ubuntu/.ssh/authorized_keys",
    "fi",
    "# Try for ec2-user (common on Amazon Linux AMIs)",
    "if id ec2-user &>/dev/null; then",
    "  echo \"Adding SSH key for ec2-user...\"",
    "  mkdir -p /home/ec2-user/.ssh",
    "  grep -q \"$SSH_KEY\" /home/ec2-user/.ssh/authorized_keys 2>/dev/null || echo \"$SSH_KEY\" >> /home/ec2-user/.ssh/authorized_keys",
    "  chown -R ec2-user:ec2-user /home/ec2-user/.ssh",
    "  chmod 700 /home/ec2-user/.ssh",
    "  chmod 600 /home/ec2-user/.ssh/authorized_keys",
    "fi",
    "# Find services that might be related to TEE",
    "echo \"Checking for potential TEE services...\"",
    "systemctl list-units --type=service | grep -i \"tee\\|enarx\\|sgx\\|sev\" || echo \"No TEE-related services found\"",
    "# Check for processes listening on port 7070",
    "echo \"Checking for processes on port 7070...\"",
    "ss -tuln | grep 7070 || echo \"No process found on port 7070\"",
    "# Check system logs for TEE-related messages",
    "echo \"Checking logs for TEE mentions...\"",
    "grep -i \"tee\\|sgx\\|sev\" /var/log/syslog 2>/dev/null || grep -i \"tee\\|sgx\\|sev\" /var/log/messages 2>/dev/null || echo \"No TEE mentions in logs\"",
    "echo \"SSH key installation complete\""
  ]
}
